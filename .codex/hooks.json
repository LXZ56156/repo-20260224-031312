{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/weapp_preflight.js\"",
            "timeout": 120,
            "statusMessage": "检查微信开发环境..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/weapp_stop.js\"",
            "timeout": 30,
            "statusMessage": "微信开发环境收尾..."
          }
        ]
      }
    ]
  }
}
