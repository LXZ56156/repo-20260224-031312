{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/user_prompt_sync_windows_mirror.py\"",
            "timeout": 120,
            "statusMessage": "预热 Windows 微信开发环境..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/stop_sync_windows_mirror.py\"",
            "timeout": 120,
            "statusMessage": "收尾同步 Windows 微信预览镜像..."
          }
        ]
      }
    ]
  }
}
