{
  "name": "badminton-miniapp",
  "version": "6.1.2",
  "private": true,
  "scripts": {
    "lint": "node scripts/run-eslint.js",
    "test": "node scripts/run-node-tests.js",
    "test:ranking": "node --test tests/ranking-core.consistency.test.js",
    "audit:scheduler-scenarios": "node scripts/audit-scheduler-scenarios.js",
    "report:scheduler-full-audit": "node scripts/generate-scheduler-full-audit.js",
    "preview:share-card": "node scripts/preview-share-card.js",
    "audit:avatars": "node scripts/audit-avatar-data.js",
    "ui:screenshot": "node scripts/dev/weapp-ui-screenshot.js",
    "screenshot:smoke": "node scripts/dev/weapp-ui-screenshot.js --smoke",
    "screenshot:schedule": "node scripts/dev/weapp-ui-screenshot.js scheduleRunning",
    "screenshot:diagnose": "node scripts/dev/weapp-screenshot-diagnose.js",
    "weapp:probe": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev/probe-weapp-automation.ps1 -Json",
    "records:latest": "node scripts/show-workflow-records.js",
    "repo:inventory": "node scripts/repo-inventory.js",
    "docs:check": "node scripts/check-docs.js",
    "verify:windows-env": "node scripts/dev/check-windows-env.js",
    "verify:changed": "node scripts/run-changed-verification.js",
    "verify:light": "node scripts/run-node-tests.js tests/changed-verification.test.js tests/docs-governance.test.js tests/repo-inventory.test.js tests/weapp-hook-config.test.js tests/codex.user-prompt-hook.test.js tests/weapp-preview-workflow.test.js tests/preview-qrcode-delivery.test.js tests/squad.fairness.test.js tests/schedule.ui-copy.test.js tests/ui-screenshot-matrix.test.js tests/ui-screenshot-safety.test.js tests/workflow-records.test.js tests/windows-dev-workflow.test.js tests/windows-native-toolchain.test.js",
    "verify:full": "npm test && npm run check && npm run docs:check && npm run lint && git diff --check",
    "check:cloud-common": "node scripts/cloud-common.js check",
    "sync:cloud-common": "node scripts/cloud-common.js sync",
    "check:deprecated-wx-api": "node scripts/check-deprecated-wx-api.js",
    "check": "npm run check:deprecated-wx-api && npm run check:cloud-common",
    "deploy": "node scripts/run-bash-script.js scripts/deploy-cloud.sh",
    "deploy:cloud": "node scripts/run-bash-script.js scripts/deploy-cloudfunctions.sh",
    "deploy:cloud:all": "node scripts/run-bash-script.js scripts/deploy-cloudfunctions.sh --all",
    "deploy:cloud:changed": "node scripts/run-bash-script.js scripts/deploy-changed-cloudfunctions.sh",
    "hooks:install-cloud-deploy": "node scripts/run-bash-script.js scripts/install-cloud-deploy-hook.sh",
    "mp:preview": "node scripts/mp-ci.js preview",
    "mp:preview:deliver": "node scripts/mp-ci.js preview-deliver",
    "mp:upload": "node scripts/mp-ci.js upload"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "miniprogram-automator": "0.12.1",
    "miniprogram-ci": "^2.1.31"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  }
}
