{
  "name": "badminton-miniapp",
  "version": "6.1.2",
  "private": true,
  "scripts": {
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint 'miniprogram/**/*.js' 'cloudfunctions/**/*.js' 'tests/**/*.js' 'scripts/**/*.js'",
    "test": "node --test tests/*.test.js",
    "test:ranking": "node --test tests/ranking-core.consistency.test.js",
    "audit:scheduler-scenarios": "node scripts/audit-scheduler-scenarios.js",
    "report:scheduler-full-audit": "node scripts/generate-scheduler-full-audit.js",
    "preview:share-card": "node scripts/preview-share-card.js",
    "audit:avatars": "node scripts/audit-avatar-data.js",
    "ui:screenshot": "node scripts/dev/weapp-ui-screenshot.js",
    "screenshot:schedule": "node scripts/dev/weapp-ui-screenshot.js scheduleRunning",
    "screenshot:diagnose": "node scripts/dev/weapp-screenshot-diagnose.js",
    "verify:windows-env": "node scripts/dev/check-windows-env.js",
    "verify:light": "node --test tests/weapp-hook-config.test.js tests/codex.user-prompt-hook.test.js tests/weapp-preview-workflow.test.js tests/squad.fairness.test.js tests/schedule.ui-copy.test.js tests/ui-screenshot-matrix.test.js tests/windows-dev-workflow.test.js",
    "verify:full": "npm test && npm run check && npm run lint && git diff --check",
    "check:cloud-common": "bash scripts/check-cloud-common.sh",
    "check:deprecated-wx-api": "bash scripts/check-deprecated-wx-api.sh",
    "check": "npm run check:deprecated-wx-api && npm run check:cloud-common",
    "deploy": "bash scripts/deploy-cloud.sh",
    "deploy:cloud": "bash scripts/deploy-cloudfunctions.sh",
    "deploy:cloud:all": "bash scripts/deploy-cloudfunctions.sh --all",
    "deploy:cloud:changed": "bash scripts/deploy-changed-cloudfunctions.sh",
    "hooks:install-cloud-deploy": "bash scripts/install-cloud-deploy-hook.sh",
    "mp:preview": "node scripts/mp-ci.js preview",
    "mp:upload": "node scripts/mp-ci.js upload"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "miniprogram-ci": "^2.1.31"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  }
}
