/* ============================================================
   MATCH PAGE — 裁判录分终端 v2
   比分舞台是第一视觉中心，8pt 网格，design token 驱动
   ============================================================ */

/* --- 页面容器 --- */
.match-page {
  padding-top: var(--space-page-y);
}

/* --- Sync Banner（固定占位，hidden 切换） --- */
/* 样式复用全局 app.wxss 中的 .sync-banner / .sync-* tone 类 */
/* 仅保留 match 页的间距微调 */
.match-page > .sync-banner {
  margin-bottom: var(--space-tight);
}

/* --- Hero 紧凑化 --- */
.hero-compact {
  padding: var(--space-card-pad-lg) var(--space-hero-pad-x);
}

.hero-head {
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-inline);
}

.hero-title-compact {
  font-size: 32rpx;
  font-weight: 780;
  line-height: 1.25;
  color: var(--neutral-950);
}

.hero-sub-compact {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--neutral-500);
}

.match-status-tag {
  background: rgba(24, 179, 104, 0.10);
  border: 1rpx solid rgba(24, 179, 104, 0.18);
  color: var(--brand-700);
}

/* --- 批量录分进度 --- */
.batch-progress {
  margin-top: var(--space-inline);
  padding: var(--space-inline) var(--space-section);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
}

.batch-progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.batch-progress-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--neutral-700);
}

.batch-progress-text {
  font-size: 21rpx;
  color: var(--neutral-500);
}

.batch-progress-bar {
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--neutral-100);
  overflow: hidden;
}

.batch-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand-500) 0%, #29c77a 100%);
  transition: width 0.4s ease;
}

/* --- 对阵区 --- */
.match-vs {
  margin-top: var(--space-tight);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--neutral-950);
}

.vs {
  margin: 0 10rpx;
  color: var(--neutral-500);
  font-weight: 700;
}

/* --- 比分舞台（统一容器） --- */
.score-stage {
  padding: var(--space-card-pad-lg);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(248, 251, 249, 0.98) 100%);
}

.score-stage-editing {
  padding-top: var(--space-card-pad);
}

.score-badge {
  min-height: 44rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  color: var(--neutral-500);
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* --- 比分行 --- */
.score-row {
  margin-top: var(--space-section);
  display: flex;
  gap: var(--space-section);
  align-items: stretch;
}

.score-stage-editing .score-row {
  margin-top: var(--space-inline);
}

.score-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.score-divider {
  width: 2rpx;
  align-self: stretch;
  margin: 8rpx 0;
  background: var(--neutral-200);
  border-radius: 999rpx;
  flex-shrink: 0;
}

.water-control {
  margin-top: var(--space-section);
  padding-top: var(--space-section);
  border-top: 1rpx solid var(--neutral-200);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-inline);
}

.water-control-copy {
  min-width: 0;
  flex: 1;
}

.water-control-title {
  margin-bottom: 4rpx;
  font-size: 26rpx;
  font-weight: 760;
  color: var(--neutral-950);
}

.water-units-picker {
  min-width: 132rpx;
  text-align: center;
  box-sizing: border-box;
}

/* --- 选手名称 --- */
.score-player-name {
  margin-bottom: var(--space-tight);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--neutral-700);
  line-height: 1.4;
  word-break: break-word;
}

/* --- 比分盒（只读） — 大字号，赛事工具感 --- */
.score-box {
  padding: var(--space-card-pad-lg);
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(244, 248, 245, 0.98) 100%);
  border: 2rpx solid rgba(15, 23, 42, 0.08);
  font-size: 56rpx;
  font-weight: 820;
  letter-spacing: 0;
  color: var(--neutral-950);
  text-align: center;
  line-height: 1.15;
  font-variant-numeric: tabular-nums;
  transition: background 160ms ease, border-color 160ms ease;
}

.score-box-readonly {
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border-color: rgba(15, 23, 42, 0.08);
}

/* --- 比分滚轮（编辑态） --- */
.score-wheel {
  margin-top: 0;
  padding: var(--space-card-pad-lg);
  min-height: auto;
  line-height: 1.15;
  border-radius: 18rpx;
  border: 2rpx solid rgba(24, 179, 104, 0.22);
  background: linear-gradient(180deg, rgba(241, 252, 245, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  font-size: 56rpx;
  font-weight: 820;
  letter-spacing: 0;
  text-align: center;
  color: var(--brand-700);
  font-variant-numeric: tabular-nums;
  transition: border-color 160ms ease, background 160ms ease;
}

.score-wheel:active {
  background: var(--brand-100);
}

/* --- 录分入口与编辑态状态 --- */
.score-entry-row {
  margin-top: var(--space-inline);
}

.score-entry-btn {
  width: 100%;
}

.score-edit-status {
  margin-top: var(--space-tight);
  min-height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-inline);
  padding: 0 4rpx;
  color: var(--neutral-600);
}

.score-edit-status-main {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--space-tight);
}

.score-edit-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--brand-500);
  box-shadow: 0 0 0 6rpx rgba(24, 179, 104, 0.12);
  flex: none;
}

.score-edit-text {
  min-width: 0;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-edit-meta {
  flex: none;
  font-size: 22rpx;
  color: var(--brand-700);
  font-weight: 700;
}

/* --- 快捷比分工具栏 --- */
.score-toolbar {
  margin-top: var(--space-tight);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--space-tight);
}

.quick-score-scroll {
  width: 100%;
  flex: none;
  min-width: 0;
  white-space: nowrap;
}

.quick-scores {
  white-space: nowrap;
}

.quick-score-chip {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  max-width: 100%;
  margin-right: var(--space-tight);
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(24, 179, 104, 0.08);
  border: 1rpx solid rgba(24, 179, 104, 0.16);
  color: var(--brand-700);
  font-size: 21rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: background 100ms ease, transform 100ms ease;
}

.quick-score-chip:last-child {
  margin-right: 0;
}

.quick-score-chip:active {
  background: var(--brand-100);
  transform: scale(0.96);
}

.score-tools {
  display: flex;
  width: 100%;
  align-items: center;
  gap: var(--space-tight);
}

.score-tool {
  flex: 1;
  width: 0;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 8rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-tool.disabled {
  opacity: 0.4;
}

/* --- 底部提交栏 — 复用全局 bottom-tray --- */
/* .bottom-tray 样式已在 app.wxss 定义 */

/* --- 重试提交 — 复用全局 retry-box --- */
/* .retry-box 样式已在 app.wxss 定义 */

/* --- Skeleton 比分舞台 --- */
.skeleton-score-row {
  margin-top: var(--space-section);
  display: flex;
  gap: var(--space-section);
}

.skeleton-score-col {
  flex: 1;
}

.skeleton-score-box {
  height: 112rpx;
  border-radius: 18rpx;
}

/* --- 响应式：窄屏 --- */
@media (max-width: 360px) {
  .score-toolbar {
    grid-template-columns: 1fr;
  }

  .score-row {
    flex-direction: column;
    gap: var(--space-inline);
  }

  .score-col {
    width: 100%;
  }

  .score-divider {
    width: 100%;
    height: 2rpx;
    margin: 4rpx 0;
    align-self: auto;
  }
}
