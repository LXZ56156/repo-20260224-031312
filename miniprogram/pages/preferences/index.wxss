/* preferences — 系统偏好设置 */

.pref-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* Chips in preferences — use neutral palette */
.pref-page .chip {
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.94);
  color: var(--neutral-700);
  font-weight: 500;
}

.pref-page .chip:active {
  transform: scale(0.984);
  filter: brightness(0.96);
}

.pref-page .chip.active {
  border-color: rgba(24, 179, 104, 0.18);
  background: rgba(24, 179, 104, 0.10);
  color: var(--brand-700);
  font-weight: 700;
}

.pref-tip {
  margin-top: var(--space-tight);
  margin-bottom: var(--space-inline);
}

/* Switch items */
.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-item .form-label {
  margin-bottom: 0;
  width: auto;
  flex: 1;
}
