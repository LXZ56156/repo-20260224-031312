/* ============================================================
   Analytics Page — 赛后战报风
   ============================================================ */

.analytics-page {
  padding-top: 24rpx;
}

/* --- Hero: 战报感强化 --- */
.analytics-hero {
  padding: 24rpx;
}

.analytics-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.analytics-hero-main {
  min-width: 0;
  flex: 1;
}

.hero-overline {
  font-size: 22rpx;
  letter-spacing: 0.22em;
  color: var(--neutral-500);
}

.analytics-hero-headline {
  margin-top: 18rpx;
  font-size: 48rpx;
  line-height: 1.08;
  font-weight: 820;
  letter-spacing: -0.5rpx;
  color: var(--neutral-950);
}

.analytics-hero-stats {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.analytics-hero-stat {
  padding: 16rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.analytics-hero-stat-label {
  font-size: 22rpx;
  color: var(--neutral-500);
}

.analytics-hero-stat-value {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.3rpx;
  color: var(--neutral-950);
}

.analytics-hero-actions {
  margin-top: 18rpx;
}

.analytics-hero-primary {
  margin-top: 0;
}

/* --- Report Card: 首屏焦点 --- */
.report-card {
  border-left: 6rpx solid var(--brand-500);
  border-color: rgba(24, 179, 104, 0.16);
}

.report-card .section-title {
  color: var(--brand-700);
}

.report-headline {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(24, 179, 104, 0.14);
  background: linear-gradient(180deg, rgba(242, 253, 246, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  font-size: 28rpx;
  font-weight: 780;
  line-height: 1.45;
  color: var(--neutral-950);
}

.report-line {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--neutral-700);
  line-height: 1.65;
}

.analytics-text-actions {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--neutral-200);
}

.analytics-copy-actions {
  width: 100%;
}

/* --- Summary: metric-card 风格 --- */
.summary-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.summary-item.metric-card {
  padding: 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(245, 250, 247, 0.94) 100%);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.summary-label.metric-card-label {
  font-size: 22rpx;
  color: var(--neutral-500);
}

.summary-value.metric-card-value {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.3rpx;
  color: var(--neutral-950);
}

/* --- TOP 3: 自适应列数卡片（2 或 3 人/队时自动伸缩） --- */
.top-cards {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
  gap: 10rpx;
}

.top-card {
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
  min-width: 0;
}

.top-card-gold {
  background: linear-gradient(180deg, rgba(255, 250, 239, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border-color: rgba(245, 158, 11, 0.18);
}

.top-card-silver {
  background: linear-gradient(180deg, rgba(248, 250, 252, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border-color: rgba(148, 163, 184, 0.18);
}

.top-card-bronze {
  background: linear-gradient(180deg, rgba(255, 246, 238, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border-color: rgba(217, 119, 6, 0.16);
}

.top-card-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  background: var(--neutral-100);
  color: var(--neutral-500);
}

.top-card-badge-gold {
  background: #FDE68A;
  color: #92400E;
}

.top-card-badge-silver {
  background: #E2E8F0;
  color: #475569;
}

.top-card-badge-bronze {
  background: #FED7AA;
  color: #9A3412;
}

.top-card-title {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 760;
  color: var(--neutral-950);
  width: 100%;
}

.top-card-subtitle {
  font-size: 21rpx;
  color: var(--neutral-500);
  line-height: 1.35;
  width: 100%;
}

.top-card-metric {
  margin-top: 4rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--neutral-700);
}

.top-card-metric-sub {
  font-size: 21rpx;
}

/* --- 完整排名: 折叠式 + 紧凑表格 --- */
.ranking-section-head {
  cursor: pointer;
}

.ranking-toggle-group {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ranking-toggle-arrow {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--brand-600);
  transition: transform 200ms ease;
}

.ranking-toggle-arrow.expanded {
  /* expanded state styling */
}

.ranking-table-wrap {
  margin-top: 8rpx;
}

.stats-head {
  margin-top: 8rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(248, 252, 249, 0.98);
}

.stats-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 4rpx;
}

.stats-row + .stats-row {
  border-top: 1rpx solid var(--neutral-100);
}

.col-rank {
  width: 40rpx;
  font-size: 23rpx;
  color: var(--neutral-500);
  font-weight: 700;
}

.col-name {
  flex: 1.4;
  min-width: 0;
  font-size: 24rpx;
  color: var(--neutral-950);
}

.col-num {
  flex: 1;
  text-align: right;
  font-size: 23rpx;
  color: var(--neutral-700);
}

.stats-head .col-num,
.stats-head .col-name,
.stats-head .col-rank {
  color: var(--neutral-500);
  font-weight: 600;
  font-size: 22rpx;
}

/* --- 更多看点 --- */
.activity-block {
  margin-top: 14rpx;
}

.activity-title {
  margin-bottom: 8rpx;
  font-size: 25rpx;
  font-weight: 760;
  color: var(--neutral-950);
}

.activity-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid var(--neutral-100);
}

.activity-item:last-child {
  border-bottom: 0;
}

.activity-label {
  flex: 1;
  min-width: 0;
  line-height: 1.45;
  font-size: 25rpx;
  color: var(--neutral-700);
}

.activity-count {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--brand-700);
}

/* --- 空态 / 重试 --- */
.retry-box {
  margin-top: 16rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
