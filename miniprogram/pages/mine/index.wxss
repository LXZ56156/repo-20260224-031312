/* ============================================================
   Mine Page — 个人仪表盘
   Design Token: app.wxss design system v2
   ============================================================ */

.mine-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* --- Hero / Dashboard --- */
.mine-hero {
  padding: var(--space-hero-pad-y) var(--space-hero-pad-x);
  background:
    radial-gradient(circle at 88% 12%, rgba(24, 179, 104, 0.16) 0%, rgba(24, 179, 104, 0.04) 30%, transparent 56%),
    linear-gradient(180deg, rgba(243, 252, 246, 0.99) 0%, rgba(255, 255, 255, 0.99) 58%, #ffffff 100%);
  border: 1rpx solid rgba(24, 179, 104, 0.12);
  box-shadow: var(--shadow-card);
}

.mine-dashboard {
  display: flex;
  flex-direction: column;
  gap: var(--space-tight);
}

.mine-profile-row {
  align-items: center;
  gap: var(--space-section);
}

.profile-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.86);
  flex-shrink: 0;
}

.profile-main {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-tight);
  min-height: 88rpx;
}

.mine-nickname {
  font-size: 34rpx;
  font-weight: 780;
  line-height: 1.25;
  color: var(--neutral-950);
}

/* --- Section Card --- */
.section-card {
  margin-top: var(--space-section);
  padding: var(--space-card-pad-lg);
}

/* --- Stats Grid --- */
.stats-grid {
  margin-top: var(--space-section);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-inline);
}

.stats-item {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(245, 250, 247, 0.94) 100%);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 16rpx;
  padding: var(--space-section);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.stats-label {
  color: var(--neutral-500);
  font-size: 24rpx;
  line-height: 1.3;
}

.stats-value {
  margin-top: 8rpx;
}

/* text-metric 类由 app.wxss 全局提供: 36rpx / font-weight 800 */

.stats-foot {
  margin-top: var(--space-section);
  font-size: 24rpx;
}

/* --- Empty State (使用全局 state-empty) --- */
.state-empty-action {
  margin-top: 8rpx;
}

/* --- Service Grid --- */
.service-grid {
  margin-top: var(--space-section);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-inline);
}

.service-btn {
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 16rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.94) 0%, rgba(247, 251, 248, 0.94) 100%);
  padding: var(--space-section) var(--space-inline);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 104rpx;
  transition: transform 120ms ease, filter 120ms ease;
}

.service-btn:active {
  transform: scale(0.985);
  filter: brightness(0.97);
}

.service-title {
  color: var(--neutral-950);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.2;
}

.service-desc {
  margin-top: 6rpx;
  color: var(--neutral-500);
  font-size: 22rpx;
  line-height: 1.2;
}
