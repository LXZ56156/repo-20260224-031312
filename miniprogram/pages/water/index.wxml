<view class="container safe-bottom water-page">
  <view class="water-loading" wx:if="{{loading}}">正在打开账本…</view>

  <view class="card water-error" wx:elif="{{loadError}}">
    <view class="water-error-title">暂时打不开</view>
    <view class="text-caption">{{loadError}}</view>
    <van-button class="water-retry-host" custom-class="water-retry" loading="{{busy}}" bind:click="onRetry">重试</van-button>
  </view>

  <block wx:else>
    <view class="water-scoreboard">
      <view class="water-score-content">
        <view class="water-score-head">
          <view class="water-kicker">WATER BOARD · 独立账本</view>
        </view>
        <view class="water-title">{{session.title}}</view>
        <view class="water-score-strip">
          <view class="water-stat"><text class="water-stat-value">{{participantCount}}</text><text class="water-stat-label">球友</text></view>
          <view class="water-stat"><text class="water-stat-value">{{entryCount}}</text><text class="water-stat-label">记录</text></view>
          <view class="water-stat"><text class="water-stat-value water-stat-balanced">{{totalNet}}</text><text class="water-stat-label">总账差</text></view>
        </view>
      </view>
    </view>

    <view class="card water-join-card" wx:if="{{!isOwner && !viewerParticipantId}}">
      <view class="section-title">加入这次打水</view>
      <view class="text-caption">可以使用自己的昵称，或认领发起人预先添加的名字。</view>
      <picker mode="selector" range="{{joinChoices}}" range-key="name" value="{{joinIndex}}" bindchange="onJoinChoiceChange">
        <view class="water-picker-row">{{joinChoices[joinIndex].name}}<text>⌄</text></view>
      </picker>
      <van-button class="water-submit-host" custom-class="water-submit" block loading="{{busy}}" bind:click="onJoin">确认加入</van-button>
    </view>

    <view class="water-command-board" wx:if="{{isOwner}}">
      <van-button class="water-game-cta" custom-class="water-game-surface" bind:click="openGameSheet">
        <view class="water-game-content">
          <view class="water-game-icon"><view class="water-play-triangle"></view></view>
          <view class="water-game-copy">
            <text class="water-game-hint">快速记录比赛</text>
            <text class="water-game-title">记一局</text>
          </view>
          <view class="water-game-arrow">›</view>
        </view>
      </van-button>
      <view class="water-command-secondary">
        <van-button class="water-secondary" custom-class="water-secondary-surface" bind:click="openManualSheet">
          <view class="water-secondary-content"><view class="water-action-icon add"></view><text>添加球友</text></view>
        </van-button>
        <van-button class="water-secondary" custom-class="water-secondary-surface" open-type="share">
          <view class="water-secondary-content"><view class="water-action-icon invite">↗</view><text>邀请加入</text></view>
        </van-button>
      </view>
    </view>

    <view class="water-ledger-card">
      <view class="water-card-head">
        <view>
          <view class="water-section-title">总账</view>
          <view class="water-section-sub">赢水 − 请水</view>
        </view>
      </view>

      <view class="water-empty" wx:if="{{!ledger.length}}">先添加球友，就可以开始记水</view>
      <view class="water-column-head" wx:if="{{ledger.length && isOwner && participantCount > 1}}">
        <text>球友 / 明细</text>
        <text>净水</text>
        <text>调整</text>
      </view>
      <view class="water-column-head view-only" wx:elif="{{ledger.length}}">
        <text>球友 / 明细</text>
        <text>净水</text>
      </view>
      <view class="water-ledger-row {{isOwner && participantCount > 1 ? '' : 'view-only'}}" wx:for="{{ledger}}" wx:key="id">
        <view class="water-person-cell">
          <view class="water-rank">{{index + 1}}</view>
          <view class="water-person">
            <view class="water-name">{{item.name}}</view>
            <view class="water-person-meta">赢 {{item.won}}　请 {{item.treat}}</view>
          </view>
        </view>
        <view class="water-net {{item.netClass}}">{{item.netText}}</view>
        <view class="water-adjust-actions" wx:if="{{isOwner && participantCount > 1}}">
          <van-button class="water-adjust minus" custom-class="water-adjust-surface" custom-style="color:#c94b45;" data-id="{{item.id}}" data-direction="minus" bind:click="openAdjustSheet">−</van-button>
          <van-button class="water-adjust plus" custom-class="water-adjust-surface" custom-style="color:#087a56;" data-id="{{item.id}}" data-direction="plus" bind:click="openAdjustSheet">＋</van-button>
        </view>
      </view>
    </view>

    <view class="water-recent-card">
      <view class="water-card-head">
        <view>
          <view class="water-section-title">最近记录</view>
          <view class="water-section-sub">刚刚发生的 {{recentEntries.length}} 笔</view>
        </view>
        <van-button class="water-undo-host" custom-class="water-undo" wx:if="{{isOwner && entryCount}}" bind:click="onUndoLast">撤销上一条</van-button>
      </view>
      <view class="water-empty" wx:if="{{!recentEntries.length}}">第一条记录会出现在这里</view>
      <view class="water-record" wx:for="{{recentEntries}}" wx:key="id">
        <view class="water-record-type"><van-tag custom-class="water-record-tag" plain round>{{item.type === 'game' ? '局' : '单'}}</van-tag></view>
        <view class="water-record-text">{{item.description}}</view>
      </view>
    </view>
  </block>
</view>

<van-popup class="water-popup-host" custom-class="water-popup" show="{{manualSheetOpen}}" position="bottom" round safe-area-inset-bottom bind:close="closeSheets">
  <view class="water-sheet">
    <view class="water-sheet-handle"></view>
    <view class="water-game-title-row">
      <view class="water-sheet-title">添加球友</view>
      <view class="water-game-available">已有 {{participantCount}} 人</view>
    </view>
    <view class="water-sheet-sub">选择一种添加方式，确认前不会改动当前名单</view>
    <view class="water-add-mode-switch">
      <button class="water-add-mode-tab {{addMode === 'manual' ? 'active' : ''}}" data-mode="manual" bindtap="onSelectAddMode">手动添加</button>
      <button class="water-add-mode-tab {{addMode === 'relay' ? 'active' : ''}}" data-mode="relay" bindtap="onSelectAddMode">导入接龙</button>
    </view>
    <block wx:if="{{addMode === 'manual'}}">
      <textarea class="water-name-input" value="{{manualNames}}" maxlength="300" placeholder="例如：小林、Chris、王姐" bindinput="onManualInput"></textarea>
      <van-button class="water-submit-host" custom-class="water-submit" block loading="{{busy}}" bind:click="submitManual">添加到本局</van-button>
    </block>
    <block wx:else>
      <textarea class="water-name-input water-relay-input" value="{{relayText}}" maxlength="2000" placeholder="粘贴微信群接龙，例如：1. 阿杰 2. 小林" bindinput="onRelayInput"></textarea>
      <view class="water-relay-preview" wx:if="{{relayText}}">
        <block wx:if="{{relayRecognizedCount}}">
          <view class="water-relay-preview-head">
            <view><text class="water-relay-count">识别到 {{relayRecognizedCount}} 人</text><text class="water-relay-note" wx:if="{{relayDuplicateCount}}">重复 {{relayDuplicateCount}} 人</text><text class="water-relay-note warning" wx:if="{{relayOverflowCount}}">超出名额 {{relayOverflowCount}} 人</text></view>
            <text class="water-relay-new">新增 {{relayNewNames.length}} 人</text>
          </view>
          <view class="water-relay-chips"><text class="water-relay-chip" wx:for="{{relayPreviewNames}}" wx:key="*this">{{item}}</text></view>
        </block>
        <view class="water-relay-empty" wx:else>还没有识别到名字，请检查接龙格式</view>
      </view>
      <van-button class="water-submit-host" custom-class="water-submit" block loading="{{busy}}" disabled="{{!relayNewNames.length}}" bind:click="submitRelay">添加 {{relayNewNames.length}} 位新球友</van-button>
    </block>
  </view>
</van-popup>

<van-popup class="water-popup-host" custom-class="water-popup water-game-popup" show="{{gameSheetOpen}}" position="bottom" round safe-area-inset-bottom bind:close="closeSheets">
  <view class="water-sheet water-game-sheet">
    <view class="water-sheet-handle"></view>
    <view class="water-game-title-row">
      <view class="water-sheet-title">记一局</view>
      <view class="water-game-available">{{participantCount}} 人可选</view>
    </view>
    <view class="water-sheet-sub">双方人数相同即可，1 对 1 也能记</view>
    <view class="water-game-side-switch">
      <button class="water-game-side-tab winner {{gameActiveSide === 'winner' ? 'active' : ''}}" data-side="winner" bindtap="onSelectGameSide">选胜方 <text>{{winnerIds.length}}</text></button>
      <button class="water-game-side-tab loser {{gameActiveSide === 'loser' ? 'active' : ''}}" data-side="loser" bindtap="onSelectGameSide">选负方 <text>{{loserIds.length}}</text></button>
    </view>
    <view class="water-game-match">
      <view class="water-game-team winner">
        <text class="water-game-team-label">胜方</text>
        <text class="water-game-team-names">{{winnerSummary}}</text>
      </view>
      <view class="water-game-versus">VS</view>
      <view class="water-game-team loser">
        <text class="water-game-team-label">负方</text>
        <text class="water-game-team-names">{{loserSummary}}</text>
      </view>
    </view>
    <view class="water-game-roster-label">
      <text>点姓名分到当前一方</text>
      <view class="water-game-legend"><text class="winner">胜</text><text class="loser">负</text></view>
    </view>
    <view class="water-game-search" wx:if="{{participantCount > 8}}">
      <text class="water-game-search-icon">⌕</text>
      <input class="water-game-search-input" type="text" confirm-type="search" value="{{gameSearchQuery}}" placeholder="搜索球友姓名" bindinput="onGameSearchInput" />
      <button class="water-game-search-clear" wx:if="{{gameSearchQuery}}" aria-label="清除搜索" bindtap="clearGameSearch"><text class="water-game-search-clear-icon">×</text></button>
      <text class="water-game-search-count" wx:else>{{gameParticipants.length}} 人</text>
    </view>
    <view class="water-chip-grid {{participantCount > 8 ? 'searchable' : ''}}" wx:if="{{gameParticipants.length}}">
      <button class="water-chip {{item.winnerSelected ? 'selected winner' : (item.loserSelected ? 'selected loser' : '')}}" wx:for="{{gameParticipants}}" wx:key="id" data-id="{{item.id}}" bindtap="onToggleGamePlayer">{{item.name}}</button>
    </view>
    <view class="water-game-search-empty" wx:else>没有找到“{{gameSearchQuery}}”</view>
    <picker mode="selector" range="{{unitOptions}}" value="{{gameUnitIndex}}" bindchange="onGameUnitChange">
      <view class="water-picker-row"><text>每人水数</text><text>{{unitOptions[gameUnitIndex]}} 水　⌄</text></view>
    </picker>
    <van-button class="water-submit-host" custom-class="water-submit" block loading="{{busy}}" bind:click="submitGame">确认记一局</van-button>
  </view>
</van-popup>

<van-popup class="water-popup-host" custom-class="water-popup" show="{{adjustSheetOpen}}" position="bottom" round safe-area-inset-bottom bind:close="closeSheets">
  <view class="water-sheet">
    <view class="water-sheet-handle"></view>
    <view class="water-sheet-title">{{adjustTargetName}} {{adjustDirection === 'plus' ? '加水' : '减水'}}</view>
    <view class="water-sheet-sub">{{adjustDirection === 'plus' ? '表示别人请 Ta' : '表示 Ta 请别人'}}</view>
    <view class="water-picker-label">算在谁头上</view>
    <picker mode="selector" range="{{counterparties}}" range-key="name" value="{{counterpartyIndex}}" bindchange="onCounterpartyChange">
      <view class="water-picker-row">{{counterparties[counterpartyIndex].name}}<text>⌄</text></view>
    </picker>
    <view class="water-picker-label">水的数量</view>
    <picker mode="selector" range="{{unitOptions}}" value="{{adjustUnitIndex}}" bindchange="onAdjustUnitChange">
      <view class="water-picker-row">{{unitOptions[adjustUnitIndex]}} 水<text>⌄</text></view>
    </picker>
    <van-button class="water-submit-host" custom-class="water-submit" block loading="{{busy}}" bind:click="submitAdjust">确认记账</van-button>
  </view>
</van-popup>
