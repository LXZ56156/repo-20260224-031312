page {
  --button-border-radius: 20rpx;
  --popup-round-border-radius: 30rpx;
  --popup-background-color: #fbfdfc;
}

.water-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  background: #edf3f1;
}

.water-loading,
.water-empty {
  padding: 56rpx 20rpx;
  color: #71807b;
  font-size: 24rpx;
  text-align: center;
}

.water-error {
  border: 1rpx solid #d7e2de;
  background: #fbfdfc;
}

.water-error-title {
  margin-bottom: 8rpx;
  color: #15241f;
  font-size: 30rpx;
  font-weight: 750;
}

.water-retry-host,
.water-submit-host {
  display: block;
  width: 100%;
}

.water-retry-host {
  margin-top: 24rpx;
}

.water-retry,
.water-submit {
  width: 100% !important;
  height: 88rpx !important;
  border: 1rpx solid #103f35 !important;
  border-radius: 20rpx !important;
  color: #ffffff !important;
  background: #103f35 !important;
  font-size: 26rpx !important;
  font-weight: 750 !important;
  box-shadow: 0 12rpx 22rpx rgba(16, 63, 53, 0.16);
}

.water-scoreboard {
  position: relative;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  color: #ffffff;
  background: #136957;
  box-shadow: 0 22rpx 42rpx rgba(14, 72, 60, 0.2);
}

.water-score-content {
  position: relative;
  z-index: 1;
  padding: 32rpx 32rpx 0;
}

.water-score-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.water-kicker {
  overflow: hidden;
  color: #b6ddd4;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1.6rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.water-title {
  overflow: hidden;
  margin: 20rpx 0 30rpx;
  color: #ffffff;
  font-size: 44rpx;
  font-weight: 850;
  line-height: 1.2;
  letter-spacing: -1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.water-score-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  margin: 0 -32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
  background: rgba(5, 51, 42, 0.14);
}

.water-stat {
  display: flex;
  min-height: 126rpx;
  flex-direction: column;
  justify-content: center;
  padding: 0 32rpx;
  border-left: 1rpx solid rgba(255, 255, 255, 0.13);
}

.water-stat:first-child {
  border-left: 0;
}

.water-stat-value {
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.05;
  font-variant-numeric: tabular-nums;
}

.water-stat-balanced {
  color: #bde8ce;
}

.water-stat-label {
  margin-top: 8rpx;
  color: #b7d4cc;
  font-size: 18rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.water-command-board {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.water-game-cta {
  display: block;
  width: 100%;
  min-width: 0;
  height: 132rpx;
}

.water-game-surface {
  width: 100% !important;
  height: 132rpx !important;
  padding: 0 32rpx !important;
  border: 1rpx solid #103f35 !important;
  border-radius: 26rpx !important;
  color: #ffffff !important;
  background: #103f35 !important;
  box-shadow: 0 15rpx 28rpx rgba(16, 63, 53, 0.2);
}

.water-game-content {
  position: absolute;
  top: 0;
  right: 32rpx;
  bottom: 0;
  left: 32rpx;
  display: flex;
  width: auto;
  align-items: center;
  gap: 20rpx;
  text-align: left;
}

.water-game-icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.1);
}

.water-play-triangle {
  width: 0;
  height: 0;
  margin-left: 5rpx;
  border-top: 11rpx solid transparent;
  border-bottom: 11rpx solid transparent;
  border-left: 17rpx solid #ffffff;
}

.water-game-copy {
  min-width: 0;
}

.water-game-arrow {
  margin-left: auto;
  color: #94b9b0;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 1;
}

.water-game-hint,
.water-game-title {
  display: block;
}

.water-game-hint {
  overflow: hidden;
  color: #afd3c9;
  font-size: 18rpx;
  font-weight: 650;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.water-game-title {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.1;
}

.water-command-secondary {
  display: grid;
  min-width: 0;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-template-rows: 100rpx;
  gap: 16rpx;
}

.water-secondary {
  display: block;
  width: 100% !important;
  min-width: 0;
  height: 100rpx;
}

.water-secondary-surface {
  width: 100% !important;
  height: 100rpx !important;
  padding: 0 18rpx !important;
  border: 1rpx solid #d7e2de !important;
  border-radius: 20rpx !important;
  color: #28443c !important;
  background: #fbfdfc !important;
  font-size: 22rpx !important;
  font-weight: 750 !important;
  box-shadow: 0 7rpx 18rpx rgba(31, 61, 51, 0.055);
}

.water-secondary-content {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
  white-space: nowrap;
}

.water-action-icon {
  position: relative;
  display: flex;
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 28rpx;
  align-items: center;
  justify-content: center;
  color: #136957;
}

.water-action-icon.add::before,
.water-action-icon.add::after {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 999rpx;
  background: #136957;
  content: '';
  transform: translate(-50%, -50%);
}

.water-action-icon.add::before {
  width: 22rpx;
  height: 3rpx;
}

.water-action-icon.add::after {
  width: 3rpx;
  height: 22rpx;
}

.water-action-icon.invite {
  font-size: 31rpx;
  font-weight: 500;
  line-height: 1;
}

.water-join-card {
  margin-top: 24rpx;
  border: 1rpx solid #d7e2de;
  border-radius: 28rpx;
  background: #fbfdfc;
}

.water-join-card .text-caption {
  margin: 8rpx 0 16rpx;
}

.water-join-card .water-submit-host {
  margin-top: 16rpx;
}

.water-ledger-card,
.water-recent-card {
  overflow: hidden;
  margin-top: 24rpx;
  border: 1rpx solid #d7e2de;
  border-radius: 28rpx;
  background: #fbfdfc;
  box-shadow: 0 10rpx 26rpx rgba(31, 61, 51, 0.065);
}

.water-card-head {
  display: flex;
  min-height: 126rpx;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
  padding: 24rpx 32rpx;
}

.water-section-title {
  color: #15241f;
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.2;
}

.water-section-sub {
  margin-top: 7rpx;
  color: #7d8b86;
  font-size: 19rpx;
  line-height: 1.3;
}

.water-column-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 64rpx 192rpx;
  align-items: center;
  min-height: 52rpx;
  box-sizing: border-box;
  padding: 0 32rpx;
  border-top: 1rpx solid #dfe8e4;
  border-bottom: 1rpx solid #dfe8e4;
  background: #f1f6f4;
  color: #71807b;
  font-size: 18rpx;
  font-weight: 750;
  letter-spacing: 0.5rpx;
}

.water-column-head.view-only {
  grid-template-columns: minmax(0, 1fr) 64rpx;
}

.water-column-head text:nth-child(2),
.water-column-head text:last-child {
  text-align: right;
}

.water-ledger-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 64rpx 192rpx;
  align-items: center;
  min-height: 140rpx;
  margin: 0 32rpx;
  border-top: 1rpx solid #e4ece8;
}

.water-ledger-row.view-only {
  grid-template-columns: minmax(0, 1fr) 64rpx;
}

.water-ledger-row:nth-of-type(3) {
  border-top: 0;
}

.water-person-cell {
  display: grid;
  grid-template-columns: 48rpx minmax(0, 1fr);
  align-items: center;
  min-width: 0;
}

.water-rank {
  color: #92a09b;
  font-size: 19rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.water-person {
  min-width: 0;
}

.water-name {
  overflow: hidden;
  color: #172a24;
  font-size: 28rpx;
  font-weight: 780;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.water-person-meta {
  overflow: hidden;
  margin-top: 7rpx;
  color: #7d8b86;
  font-size: 19rpx;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.water-net {
  font-size: 34rpx;
  font-weight: 850;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

.water-net.is-positive {
  color: #087a56;
}

.water-net.is-negative {
  color: #c94b45;
}

.water-net.is-even {
  color: #697872;
}

.water-adjust-actions {
  display: grid;
  grid-template-columns: repeat(2, 88rpx);
  justify-content: end;
  gap: 0;
  margin-left: 0;
}

.water-adjust-actions .water-adjust {
  display: block;
  width: 88rpx !important;
  min-width: 88rpx;
  max-width: 88rpx;
  min-height: 84rpx;
}

.water-adjust-surface {
  width: 88rpx !important;
  min-width: 88rpx !important;
  height: 84rpx !important;
  padding: 0 !important;
  border: 1rpx solid #d7e2de !important;
  border-radius: 0 !important;
  background: #fbfdfc !important;
  font-size: 31rpx !important;
  font-weight: 750 !important;
  line-height: 84rpx !important;
}

.water-adjust-actions .water-adjust:first-child .water-adjust-surface {
  border-radius: 18rpx 0 0 18rpx !important;
}

.water-adjust-actions .water-adjust:last-child .water-adjust-surface {
  border-radius: 0 18rpx 18rpx 0 !important;
  border-left: 0 !important;
}

.water-undo-host {
  flex: 0 0 auto;
}

.water-undo {
  height: 64rpx !important;
  padding: 0 !important;
  border: 0 !important;
  color: #63736d !important;
  background: transparent !important;
  font-size: 20rpx !important;
  font-weight: 650 !important;
  line-height: 64rpx !important;
}

.water-record {
  display: grid;
  grid-template-columns: 60rpx minmax(0, 1fr);
  align-items: center;
  gap: 20rpx;
  min-height: 116rpx;
  margin: 0 32rpx;
  border-top: 1rpx solid #e4ece8;
}

.water-record-type {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
}

.water-record-tag {
  display: flex !important;
  width: 58rpx !important;
  height: 58rpx !important;
  align-items: center !important;
  justify-content: center !important;
  box-sizing: border-box !important;
  padding: 0 !important;
  border: 1rpx solid #cfe0da !important;
  border-radius: 18rpx !important;
  color: #136957 !important;
  background: #eef6f3 !important;
  font-size: 20rpx !important;
  font-weight: 850 !important;
}

.water-record-text {
  min-width: 0;
  color: #45574f;
  font-size: 23rpx;
  line-height: 1.5;
}

.water-picker-row {
  display: flex;
  min-height: 84rpx;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid #d7e2de;
  border-radius: 16rpx;
  color: #31473f;
  background: #f3f7f5;
  font-size: 27rpx;
}

.water-popup {
  max-height: 84vh !important;
  background: #fbfdfc !important;
}

.water-sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 14rpx 24rpx 28rpx;
}

.water-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 20rpx;
  border-radius: 999rpx;
  background: #d3dfda;
}

.water-sheet-title {
  color: #15241f;
  font-size: 34rpx;
  font-weight: 800;
}

.water-sheet-sub {
  margin-top: 4rpx;
  color: #71807b;
  font-size: 23rpx;
}

.water-name-input {
  width: 100%;
  height: 220rpx;
  box-sizing: border-box;
  margin: 20rpx 0;
  padding: 18rpx;
  border: 1rpx solid #d7e2de;
  border-radius: 16rpx;
  background: #f3f7f5;
  font-size: 28rpx;
}

.water-side-label,
.water-picker-label {
  margin: 22rpx 0 10rpx;
  color: #31473f;
  font-size: 24rpx;
  font-weight: 700;
}

.winner-label {
  color: #087a56;
}

.loser-label {
  color: #b8443f;
}

.water-chip-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.water-chip {
  min-width: 132rpx;
  height: 68rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid #d7e2de;
  border-radius: 999rpx;
  color: #31473f;
  background: #fbfdfc;
  font-size: 24rpx;
  line-height: 68rpx;
}

.water-chip::after {
  border: 0;
}

.water-chip.selected.winner {
  border-color: rgba(8, 122, 86, 0.35);
  color: #087a56;
  background: #e8f5ef;
}

.water-chip.selected.loser {
  border-color: rgba(184, 68, 63, 0.28);
  color: #b8443f;
  background: #fff1ef;
}

.water-sheet .water-picker-row {
  margin: 10rpx 0 20rpx;
}

@media (prefers-reduced-motion: reduce) {
  .water-scoreboard,
  .water-game-surface,
  .water-ledger-card,
  .water-recent-card,
  .water-submit,
  .water-retry {
    box-shadow: none;
  }
}
