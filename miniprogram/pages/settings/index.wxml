<view class="container safe-bottom settings-page" wx:if="{{tournament}}">
  <view class="sync-banner sync-{{syncStatusTone}}" hidden="{{!syncStatusVisible}}">
    <view class="sync-banner-main">
      <view class="sync-banner-text">{{syncStatusText}}</view>
      <view class="sync-banner-meta" wx:if="{{syncStatusMeta}}">{{syncStatusMeta}}</view>
    </view>
    <text class="sync-banner-action" bindtap="onRetry">{{syncStatusActionText}}</text>
  </view>

  <view class="hero">
    <view class="hero-title">{{pageTitle}}</view>
  </view>

  <view class="card panel panel-soft context-panel">
    <view class="section-head">
      <view class="section-title">{{contextTitle}}</view>
      <text class="count-pill">{{mandatoryDone}} / {{mandatoryTotal}}</text>
    </view>
  </view>

  <view class="card panel settings-panel" id="section-params">
    <view class="row row-top">
      <view class="section-title">修改比赛</view>
      <text class="status-pill {{settingsReady ? 'ok' : 'pending'}}">{{settingsReady ? '已完成' : '待完成'}}</text>
    </view>

    <view class="muted small" wx:if="{{settingsGateHint}}">{{settingsGateHint}}</view>

    <view class="form-item">
      <view class="form-label">赛事名称</view>
      <view class="form-field">
        <input
          class="picker input-like {{isAdmin && tournament.status==='draft' && canConfigureSettings && canEditTournamentName ? '' : 'disabled'}}"
          placeholder="请输入赛事名称"
          value="{{name}}"
          bindinput="onNameInput"
          disabled="{{!(isAdmin && tournament.status==='draft' && canConfigureSettings && canEditTournamentName)}}"
        />
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">总场次</view>
      <view class="form-field">
        <block wx:if="{{isAdmin && tournament.status==='draft' && canConfigureSettings}}">
          <block wx:if="{{useMatchPresetOptions}}">
            <view class="picker">{{editM}} 场</view>
            <view class="muted small settings-match-meta" wx:if="{{currentCustomMatchLabel}}">{{currentCustomMatchLabel}}</view>
            <text class="settings-link-btn" wx:if="{{showAdvancedMatchEntry}}" bindtap="toggleAdvancedMatchPicker">
              {{showAdvancedMatchPicker ? '收起高级自定义' : '高级自定义'}}
            </text>
            <picker
              wx:if="{{showAdvancedMatchPicker && useSimpleMPicker}}"
              mode="selector"
              range="{{mOptions}}"
              value="{{mIndex}}"
              bindchange="onPickTotalMatchesSimple"
            >
              <view class="picker settings-advanced-picker">{{editM}}</view>
            </picker>
            <picker
              wx:elif="{{showAdvancedMatchPicker}}"
              mode="multiSelector"
              range="{{mDigitRange}}"
              value="{{mDigitValue}}"
              bindchange="onPickTotalMatches"
            >
              <view class="picker settings-advanced-picker">{{editM}}</view>
            </picker>
          </block>
          <picker wx:elif="{{useSimpleMPicker}}" mode="selector" range="{{mOptions}}" value="{{mIndex}}" bindchange="onPickTotalMatchesSimple">
            <view class="picker">{{editM}}</view>
          </picker>
          <picker wx:else mode="multiSelector" range="{{mDigitRange}}" value="{{mDigitValue}}" bindchange="onPickTotalMatches">
            <view class="picker">{{editM}}</view>
          </picker>
        </block>
        <block wx:else>
          <view class="picker disabled">{{tournament.totalMatches || '—'}}</view>
        </block>
      </view>
    </view>

    <view class="form-item" wx:if="{{matchShortcutHint || matchShortcutOptions.length || matchPresetUnavailableHint}}">
      <view class="form-label">快捷设置</view>
      <view class="form-field">
        <view class="muted small" wx:if="{{matchShortcutHint}}">{{matchShortcutHint}}</view>
        <view class="muted small" wx:if="{{matchPresetUnavailableHint}}">{{matchPresetUnavailableHint}}</view>
        <view class="quick-match-shortcuts" wx:if="{{matchShortcutOptions.length}}">
          <view
            wx:for="{{matchShortcutOptions}}"
            wx:key="key"
            class="chip quick-match-shortcut {{editM===item.value ? 'active' : ''}} {{item.disabled ? 'disabled' : ''}}"
            data-value="{{item.value}}"
            data-disabled="{{item.disabled ? 1 : 0}}"
            bindtap="onTapMatchShortcut"
          >{{item.label}}</view>
        </view>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">每轮最多场数</view>
      <view class="form-field">
        <block wx:if="{{isAdmin && tournament.status==='draft' && canConfigureSettings}}">
          <picker mode="selector" range="{{courtOptions}}" value="{{courtIndex}}" bindchange="onPickCourts">
            <view class="picker">{{editC}}</view>
          </picker>
        </block>
        <block wx:else>
          <view class="picker disabled">{{tournament.courts || '—'}}</view>
        </block>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">每局分制</view>
      <view class="form-field">
        <block wx:if="{{isAdmin && tournament.status==='draft' && canConfigureSettings}}">
          <picker mode="selector" range="{{pointsOptions}}" value="{{pointsIndex}}" bindchange="onPickPointsPerGame">
            <view class="picker">{{pointsPerGame}} 分</view>
          </picker>
        </block>
        <block wx:else>
          <view class="picker disabled">{{pointsPerGame}} 分</view>
        </block>
      </view>
    </view>

    <view class="form-item" wx:if="{{showSquadEndCondition}}">
      <view class="form-label">结束条件</view>
      <view class="form-field">
        <block wx:if="{{isAdmin && tournament.status==='draft' && canConfigureSettings}}">
          <picker mode="selector" range="{{endConditionOptions}}" range-key="label" value="{{endConditionIndex}}" bindchange="onPickEndConditionType">
            <view class="picker">{{endConditionOptions[endConditionIndex].label}}</view>
          </picker>
        </block>
        <block wx:else>
          <view class="picker disabled">{{endConditionOptions[endConditionIndex].label}}</view>
        </block>
      </view>
    </view>

    <view class="form-item" wx:if="{{showSquadEndCondition}}">
      <view class="form-label">{{endConditionTargetLabel}}</view>
      <view class="form-field">
        <block wx:if="{{isAdmin && tournament.status==='draft' && canConfigureSettings && showEndConditionTargetPicker}}">
          <picker mode="selector" range="{{endConditionTargetOptions}}" value="{{endConditionTargetIndex}}" bindchange="onPickEndConditionTarget">
            <view class="picker">{{endConditionTarget}} {{endConditionTargetUnit}}</view>
          </picker>
        </block>
        <block wx:elif="{{showSquadEndCondition}}">
          <view class="picker disabled">{{endConditionTarget}} {{endConditionTargetUnit}}</view>
        </block>
      </view>
    </view>

    <button class="btn btn-primary settings-save" bindtap="saveSettings" loading="{{settingsBusy}}" disabled="{{settingsBusy}}" wx:if="{{isAdmin && tournament.status==='draft' && canConfigureSettings}}">保存修改</button>
  </view>

  <view class="retry-box panel-soft" wx:if="{{canRetryAction}}">
    <view class="muted small">{{lastFailedActionText}}</view>
    <button class="btn btn-subtle btn-sm" bindtap="retryLastAction">重试上次操作</button>
  </view>
</view>

<view class="container safe-bottom settings-page" wx:elif="{{loadError}}">
  <view class="card panel state-error">
    <view class="state-error-icon">⚠️</view>
    <view class="state-error-title">{{loadErrorTitle}}</view>
    <view class="state-error-desc">{{loadErrorMessage}}</view>
    <view class="state-error-actions">
      <button class="btn btn-subtle" bindtap="onRetry">重新加载</button>
      <button class="btn btn-ghost" bindtap="goHome" wx:if="{{showLoadErrorHome}}">返回首页</button>
    </view>
  </view>
</view>

<view class="container safe-bottom settings-page" wx:else>
  <view class="card panel">
    <view class="state-empty">
      <view class="state-empty-icon">⏳</view>
      <view class="state-empty-title">加载中...</view>
      <view class="state-empty-desc">正在同步赛事设置</view>
    </view>
  </view>
</view>
