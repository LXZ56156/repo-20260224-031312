/* settings — 比赛设置中心 */

.settings-page {
  padding-top: var(--space-page-y);
}

/* Panels */
.settings-panel {
  padding: var(--space-card-pad-lg);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(248, 251, 249, 0.98) 100%);
}

.context-panel {
  padding: var(--space-card-pad-lg);
  background: linear-gradient(180deg, rgba(245, 252, 247, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border-color: rgba(24, 179, 104, 0.12);
}

/* Status pill */
.status-pill {
  min-height: 44rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.94);
  color: var(--neutral-500);
  font-size: 22rpx;
  font-weight: 600;
}

.status-pill.ok {
  background: rgba(24, 179, 104, 0.10);
  border-color: rgba(24, 179, 104, 0.18);
  color: var(--brand-700);
}

.status-pill.pending {
  background: rgba(245, 158, 11, 0.12);
  border-color: rgba(245, 158, 11, 0.18);
  color: #B45309;
}

.status-pill.optional {
  background: var(--neutral-100);
  border-color: var(--neutral-200);
  color: var(--neutral-500);
}

.picker {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.98);
  padding: 0 18rpx;
  font-size: 28rpx;
  color: var(--neutral-950);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.picker.disabled {
  color: var(--neutral-500);
  background: rgba(248, 250, 252, 0.96);
}

.input-like {
  width: 100%;
  box-sizing: border-box;
}

.form-field {
  width: 100%;
}

.settings-match-meta {
  margin-top: var(--space-tight);
}

.settings-link-btn {
  display: inline-flex;
  margin-top: var(--space-inline);
  color: var(--brand-600);
  font-size: 25rpx;
  font-weight: 700;
  min-height: 44rpx;
  align-items: center;
}

.settings-advanced-picker {
  margin-top: var(--space-inline);
}

.settings-save {
  margin-top: var(--space-card-pad-lg);
}

/* row-top in settings context */
.row-top {
  justify-content: space-between;
}

/* State title */
.state-title {
  font-size: 30rpx;
  font-weight: 740;
  margin-bottom: 8rpx;
}

/* Referee section (if present) */
.referee-current {
  margin-top: var(--space-panel-pad);
  padding: var(--space-section);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: var(--space-panel-pad);
}

.referee-current.set {
  background: linear-gradient(180deg, rgba(255, 248, 234, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border: 1rpx solid rgba(245, 158, 11, 0.16);
}

.referee-current.unset {
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
}

.referee-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.referee-name {
  font-size: 30rpx;
  font-weight: 780;
  color: var(--neutral-950);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.referee-actions {
  display: flex;
  align-items: center;
  gap: var(--space-tight);
}

.referee-btn {
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  font-size: 25rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.referee-btn.primary {
  background: var(--brand-500);
  color: #fff;
}

button.referee-btn::after {
  border: none;
}

/* Players */
.players {
  margin-top: var(--space-panel-pad);
}

.player {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-inline);
  padding: var(--space-inline) 0;
  border-bottom: 1rpx solid var(--neutral-100);
}

.player:last-child {
  border-bottom: 0;
}

.player-name {
  font-size: 27rpx;
  color: var(--neutral-950);
  font-weight: 600;
}

.player-main {
  display: flex;
  align-items: center;
  gap: var(--space-tight);
  min-width: 0;
}

.player-gender-chip {
  min-width: 64rpx;
  text-align: center;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  color: var(--neutral-700);
  font-size: 22rpx;
  font-weight: 600;
}

/* Retry */
.retry-box {
  margin-top: var(--space-section);
  padding: var(--space-panel-pad) var(--space-section);
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-inline);
}
