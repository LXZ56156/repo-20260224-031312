/* ============================================================
   Profile Page — 个人资料编辑
   Design Token: app.wxss design system v2
   ============================================================ */

.profile-page {
  gap: var(--space-section);
}

/* --- Form Card --- */
.profile-form-card {
  padding: var(--space-hero-pad-x);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(248, 251, 249, 0.98) 100%);
}

/* --- Avatar Section (居中) --- */
.profile-avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-section);
  padding-bottom: var(--space-hero-pad-y);
  border-bottom: 1rpx solid var(--neutral-200);
}

.profile-avatar {
  width: 136rpx;
  height: 136rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 3rpx solid rgba(15, 23, 42, 0.08);
}

.avatar-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-inline);
  justify-content: center;
}

.avatar-tip {
  margin-top: 0;
}

/* --- Quick Fill (更紧凑) --- */
.quick-fill-box {
  margin-top: var(--space-hero-pad-y);
  padding: var(--space-inline);
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
}

.quick-fill-btn {
  margin: 0;
}

/* --- Form Group --- */
.profile-form-group {
  margin-top: 8rpx;
}

.form-item {
  margin-top: var(--space-hero-pad-y);
}

.form-label {
  font-size: 26rpx;
  color: var(--neutral-500);
  margin-bottom: var(--space-inline);
  font-weight: 500;
}

/* --- Gender Segment (更清晰) --- */
.gender-segment {
  display: flex;
  gap: var(--space-inline);
}

.gender-option {
  flex: 1;
  min-height: 80rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.96);
  color: var(--neutral-700);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  transition: transform 120ms ease, filter 120ms ease, border-color 120ms ease, background 120ms ease;
}

.gender-option-press {
  transform: scale(0.986);
  filter: brightness(0.97);
}

.gender-option.selected {
  background: linear-gradient(180deg, rgba(241, 252, 245, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border-color: rgba(24, 179, 104, 0.22);
  color: var(--brand-700);
  box-shadow: 0 0 0 2rpx rgba(24, 179, 104, 0.1);
}

.gender-check {
  font-size: 22rpx;
  font-weight: 800;
}

.gender-segment-error {
  padding: 6rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--danger);
  background: #FEF2F2;
}

/* --- Field Errors --- */
.field-error {
  margin-top: 8rpx;
  color: var(--danger);
  font-size: 22rpx;
  font-weight: 500;
  text-align: left;
}

.input-error {
  border-color: var(--danger) !important;
  background: #FEF2F2 !important;
}

/* --- Save Actions (sticky bottom tray) --- */
.profile-actions {
  margin-top: var(--space-hero-pad-y);
}
