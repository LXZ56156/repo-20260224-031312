/* ============================================================
   Launch 页面 — 赛制选择面板
   ============================================================ */

.launch-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* --- Hero --- */
.launch-hero {
  padding: var(--space-hero-pad-y) var(--space-hero-pad-x);
  border-radius: 24rpx;
  background: transparent;
  color: var(--neutral-950);
  border: 0;
  box-shadow: none;
}

.launch-hero-title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0;
}

.launch-hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--neutral-500);
  line-height: 1.45;
}

/* --- Mode Card --- */
.launch-card {
  margin-top: var(--space-section);
  position: relative;
  overflow: hidden;
  padding: 24rpx;
  background: #ffffff;
  border-color: #dfe8e2;
  box-shadow: none;
}

.launch-water-card {
  border-color: #dfe8e2;
  background: #ffffff;
  box-shadow: none;
}

.launch-water-accent {
  width: 8rpx;
  background: #277bd6;
}

.launch-water-kicker {
  margin-left: var(--space-tight);
  margin-bottom: 8rpx;
  color: #137747;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.launch-water-btn {
  display: flex;
  width: 100% !important;
  max-width: none !important;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  height: 48px;
  line-height: 1.35;
  margin: 28rpx 0 0 !important;
  color: #ffffff;
  background: #137747;
}

.launch-water-history {
  width: 100% !important;
  max-width: none !important;
  margin-top: 8rpx !important;
}

.launch-water-secondary {
  display: flex;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  margin: 0 !important;
  padding: 0 16rpx !important;
  color: #136957 !important;
  background: transparent !important;
  font-size: 26rpx !important;
}

.launch-water-recent {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid #e1e9e4;
  color: #5f6f69;
  font-size: 24rpx;
  line-height: 1.5;
  overflow-wrap: break-word;
}

.launch-water-recent-copy { min-width: 0; flex: 1; }
.launch-water-recent-label { color: #192d23; font-size: 28rpx; font-weight: 650; }
.launch-water-recent-title { margin-top: 6rpx; }
.launch-water-recent .launch-water-secondary { flex: 0 0 auto; }
.launch-water-card .launch-water-accent { background: #137747; }

.launch-section-label {
  margin: 28rpx 4rpx 0;
  color: var(--neutral-700);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 左侧色彩暗示条 */
.launch-card-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  border-radius: 20rpx 0 0 20rpx;
  background: var(--neutral-300);
  transition: background 200ms ease;
}

/* 不同模式的色彩暗示 */
.launch-card-rotation_6 .launch-card-accent,
.launch-card-rotation_7 .launch-card-accent,
.launch-card-rotation_8 .launch-card-accent,
.launch-card-multi .launch-card-accent {
  background: var(--brand-500);
}

.launch-card-squad .launch-card-accent {
  background: var(--info-500);
}

.launch-card-fixed .launch-card-accent {
  background: #F59E0B;
}

/* 默认推荐模式 — 轻微强调 */
.launch-card.is-default {
  border-color: rgba(24, 179, 104, 0.18);
  box-shadow: none;
}

.launch-card.is-default .launch-card-accent {
  width: 8rpx;
}

.launch-row {
  align-items: flex-start;
  gap: var(--space-inline);
  padding-left: var(--space-tight);
}

.launch-title {
  font-size: 32rpx;
  font-weight: 780;
  line-height: 1.3;
  color: var(--neutral-950);
}

.launch-sub {
  margin-top: 8rpx;
  line-height: 1.5;
  color: var(--neutral-500);
  font-size: 24rpx;
}

.launch-actions {
  margin-top: var(--space-section);
  padding-left: var(--space-tight);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-inline);
}

/* 规则说明 — text link 弱化 */
.launch-rule-link {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  padding: 0 8rpx;
  color: var(--neutral-500);
  font-size: 24rpx;
  font-weight: 500;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

.launch-action-spacer {
  visibility: hidden;
  pointer-events: none;
}

/* 发起按钮 — primary CTA */
.launch-btn {
  min-width: 160rpx;
  width: 112px !important;
  margin: 0 !important;
  flex: 0 0 112px;
  height: 44px;
  line-height: 1.35;
  box-shadow: none;
}

.launch-rule-link {
  margin-right: auto;
}
