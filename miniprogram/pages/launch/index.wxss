/* ============================================================
   Launch 页面 — 赛制选择面板
   ============================================================ */

.launch-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* --- Hero --- */
.launch-hero {
  padding: var(--space-hero-pad-y) var(--space-hero-pad-x);
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 88% 12%, rgba(24, 179, 104, 0.16) 0%, rgba(24, 179, 104, 0.04) 30%, transparent 56%),
    linear-gradient(180deg, rgba(243, 252, 246, 0.99) 0%, rgba(255, 255, 255, 0.99) 58%, #ffffff 100%);
  color: var(--neutral-950);
  border: 1rpx solid rgba(24, 179, 104, 0.12);
  box-shadow: var(--shadow-card);
}

.launch-hero-title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.3rpx;
}

.launch-hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--neutral-500);
  line-height: 1.45;
}

/* --- Mode Card --- */
.launch-card {
  margin-top: var(--space-section);
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.99) 0%, rgba(248, 251, 249, 0.98) 100%);
}

/* 左侧色彩暗示条 */
.launch-card-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  border-radius: 20rpx 0 0 20rpx;
  background: var(--neutral-300);
  transition: background 200ms ease;
}

/* 不同模式的色彩暗示 */
.launch-card-multi_rotate .launch-card-accent {
  background: var(--brand-500);
}

.launch-card-squad_doubles .launch-card-accent {
  background: var(--info-500);
}

.launch-card-fixed_pair_rr .launch-card-accent {
  background: #F59E0B;
}

/* 默认推荐模式 — 轻微强调 */
.launch-card.is-default {
  border-color: rgba(24, 179, 104, 0.18);
  box-shadow: 0 10rpx 24rpx rgba(24, 179, 104, 0.12);
}

.launch-card.is-default .launch-card-accent {
  width: 8rpx;
}

.launch-row {
  align-items: flex-start;
  gap: var(--space-inline);
  padding-left: var(--space-tight);
}

.launch-title {
  font-size: 32rpx;
  font-weight: 780;
  line-height: 1.3;
  color: var(--neutral-950);
}

.launch-sub {
  margin-top: 8rpx;
  line-height: 1.5;
  color: var(--neutral-500);
  font-size: 24rpx;
}

.launch-actions {
  margin-top: var(--space-section);
  padding-left: var(--space-tight);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-section);
}

/* 规则说明 — text link 弱化 */
.launch-rule-link {
  color: var(--neutral-500);
  font-size: 24rpx;
  font-weight: 500;
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

/* 发起按钮 — primary CTA */
.launch-btn {
  min-width: 160rpx;
}
