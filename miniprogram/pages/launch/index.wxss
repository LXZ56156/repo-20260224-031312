/* ============================================================
   Launch 页面 — 赛制选择面板
   ============================================================ */

.launch-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* --- Hero --- */
.launch-hero {
  padding: var(--space-hero-pad-y) var(--space-hero-pad-x);
  border-radius: 20rpx;
  background: var(--surface-card);
  color: var(--neutral-950);
  border: 1rpx solid rgba(24, 179, 104, 0.12);
  box-shadow: none;
}

.launch-hero-title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: 0;
}

.launch-hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--neutral-500);
  line-height: 1.45;
}

/* --- Mode Card --- */
.launch-card {
  margin-top: var(--space-section);
  position: relative;
  overflow: hidden;
  background: var(--surface-card);
}

/* 左侧色彩暗示条 */
.launch-card-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  border-radius: 20rpx 0 0 20rpx;
  background: var(--neutral-300);
  transition: background 200ms ease;
}

/* 不同模式的色彩暗示 */
.launch-card-rotation_6 .launch-card-accent,
.launch-card-rotation_7 .launch-card-accent,
.launch-card-rotation_8 .launch-card-accent,
.launch-card-multi .launch-card-accent {
  background: var(--brand-500);
}

.launch-card-squad .launch-card-accent {
  background: var(--info-500);
}

.launch-card-fixed .launch-card-accent {
  background: #F59E0B;
}

/* 默认推荐模式 — 轻微强调 */
.launch-card.is-default {
  border-color: rgba(24, 179, 104, 0.18);
  box-shadow: none;
}

.launch-card.is-default .launch-card-accent {
  width: 8rpx;
}

.launch-card.is-legacy-selected {
  border-color: rgba(24, 179, 104, 0.42);
  box-shadow: 0 0 0 2rpx rgba(24, 179, 104, 0.08);
}

.launch-row {
  align-items: flex-start;
  gap: var(--space-inline);
  padding-left: var(--space-tight);
}

.launch-title {
  font-size: 32rpx;
  font-weight: 780;
  line-height: 1.3;
  color: var(--neutral-950);
}

.launch-sub {
  margin-top: 8rpx;
  line-height: 1.5;
  color: var(--neutral-500);
  font-size: 24rpx;
}

.launch-actions {
  margin-top: var(--space-section);
  padding-left: var(--space-tight);
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: var(--space-inline);
}

/* 规则说明 — text link 弱化 */
.launch-rule-link {
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 8rpx;
  color: var(--neutral-500);
  font-size: 24rpx;
  font-weight: 500;
  text-decoration: none;
}

/* 发起按钮 — primary CTA */
.launch-btn {
  min-width: 160rpx;
}
