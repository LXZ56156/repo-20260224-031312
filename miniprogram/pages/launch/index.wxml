<view class="container safe-bottom launch-page">
  <view class="launch-hero reveal reveal-1">
    <view class="launch-hero-title">选择赛制</view>
    <view class="launch-hero-sub">选择赛制，直接创建比赛</view>
  </view>

  <view
    class="card panel launch-card launch-card-{{item.key}} {{index === 0 ? 'is-default' : ''}} reveal reveal-{{index + 2}}"
    wx:for="{{modeCards}}"
    wx:key="key"
  >
    <view class="launch-card-accent"></view>
    <view class="row launch-row">
      <view class="flex-1 minw0">
        <view class="launch-title">{{item.name}}</view>
        <view class="launch-sub text-caption">{{item.summary}}</view>
      </view>
      <text class="count-pill" wx:if="{{item.badge}}">{{item.badge}}</text>
    </view>
    <view class="launch-actions">
      <text class="launch-rule-link" data-mode="{{item.mode}}" data-preset-key="{{item.presetKey}}" bindtap="onShowRules">规则</text>
      <button
        class="btn btn-primary btn-sm btn-inline launch-btn"
        data-key="{{item.key}}"
        data-mode="{{item.mode}}"
        data-preset-key="{{item.presetKey}}"
        bindtap="onCreate"
        loading="{{createBusy && createBusyKey===item.key}}"
        disabled="{{createBusy}}"
      >创建</button>
    </view>
  </view>

  <view class="retry-box panel-soft" wx:if="{{canRetryAction}}">
    <view class="muted small">{{lastFailedActionText}}</view>
    <button class="btn btn-subtle btn-sm" bindtap="retryLastAction">重试创建</button>
  </view>
</view>
