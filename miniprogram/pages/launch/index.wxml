<view class="container safe-bottom launch-page">
  <view class="launch-hero reveal reveal-1">
    <view class="launch-hero-title">选择玩法</view>
    <view class="launch-hero-sub">快速记水，或发起完整比赛</view>
  </view>

  <view class="card panel launch-card launch-water-card reveal reveal-2">
    <view class="launch-card-accent launch-water-accent"></view>
    <view class="launch-water-kicker">轻量工具</view>
    <view class="row launch-row">
      <view class="flex-1 minw0">
        <view class="launch-title">快速打水</view>
        <view class="launch-sub text-caption">每次单独记账，添加这次的球友就能开始</view>
      </view>
    </view>
    <button class="btn launch-water-btn" bindtap="onStartWater">新建打水</button>
    <view class="launch-water-recent" wx:if="{{recentWater}}">
      <view class="launch-water-recent-copy">
        <view class="launch-water-recent-label">继续最近</view>
        <view class="launch-water-recent-title">{{recentWater.title}}</view>
      </view>
      <button class="launch-water-secondary" bindtap="onContinueWater">继续记水 ›</button>
    </view>
    <button class="launch-water-secondary launch-water-history" bindtap="onWaterHistory">历史账本 ›</button>
  </view>

  <view class="launch-section-label">完整比赛</view>

  <view
    class="card panel launch-card launch-card-{{item.key}} {{index === 0 ? 'is-default' : ''}} reveal reveal-{{index + 3}}"
    wx:for="{{modeCards}}"
    wx:key="key"
  >
    <view class="launch-card-accent"></view>
    <view class="row launch-row">
      <view class="flex-1 minw0">
        <view class="launch-title">{{item.name}}</view>
        <view class="launch-sub text-caption">{{item.summary}}</view>
      </view>
      <text class="count-pill" wx:if="{{item.badge}}">{{item.badge}}</text>
    </view>
    <view class="launch-actions">
      <text class="launch-rule-link" data-mode="{{item.mode}}" data-preset-key="{{item.presetKey}}" bindtap="onShowRules">规则说明</text>
      <button class="btn btn-primary btn-sm btn-inline launch-btn" data-mode="{{item.mode}}" data-preset-key="{{item.presetKey}}" bindtap="onStart">发起</button>
    </view>
  </view>
</view>
