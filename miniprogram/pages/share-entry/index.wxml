<view class="container safe-bottom share-entry-page">
  <view class="sync-banner sync-{{syncStatusTone}}" hidden="{{!syncStatusVisible}}">
    <view class="sync-banner-main">
      <view class="sync-banner-text">{{syncStatusText}}</view>
      <view class="sync-banner-meta" wx:if="{{syncStatusMeta}}">{{syncStatusMeta}}</view>
    </view>
    <text class="sync-banner-action" bindtap="onRetry">{{syncStatusActionText}}</text>
  </view>

  <block wx:if="{{tournament}}">
    <view class="share-hero hero reveal reveal-1">
      <view class="row hero-top">
        <view class="share-title ellipsis">{{preview.tournamentName}}</view>
        <view class="tag {{preview.statusClass}}">{{preview.statusText}}</view>
      </view>
      <view class="share-pills">
        <text class="share-pill">{{preview.modeLabel}}</text>
        <text class="share-pill" wx:if="{{preview.lifecycle==='draft'}}">{{preview.playersCountText}}</text>
        <text class="share-pill" wx:else>{{preview.progressText}}</text>
      </view>
    </view>

    <view class="share-decision reveal reveal-2">
      <view class="share-identity-status {{identityPending ? 'is-pending' : ''}} {{identityTimedOut ? 'is-timeout' : ''}}" wx:if="{{preview.identityStatusText}}">
        {{preview.identityStatusText}}
      </view>

      <view class="share-state-preview" wx:if="{{preview.showParticipantPreview || preview.showRankingPreview}}">
        <view class="participant-preview" wx:if="{{preview.showParticipantPreview}}">
          <view class="participant-preview-head">
            <text class="participant-preview-title">参赛名单</text>
            <text class="participant-preview-meta">{{preview.playersCountText}}</text>
          </view>
          <view class="participant-avatar-row" wx:if="{{preview.participantPreviewList.length}}">
            <view class="participant-avatar" wx:for="{{preview.participantPreviewList}}" wx:key="id" title="{{item.name}}">
              <image wx:if="{{item.showAvatar}}" class="participant-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" data-avatar-raw="{{item.avatarRaw || item.avatarUrl}}" binderror="onParticipantAvatarError"></image>
              <text wx:else class="participant-avatar-text">{{item.initial}}</text>
            </view>
            <view class="participant-overflow" wx:if="{{preview.participantOverflowText}}">{{preview.participantOverflowText}}</view>
          </view>
          <view class="share-empty-note" wx:else>暂无参赛成员</view>
        </view>

        <view class="ranking-preview" wx:if="{{preview.showRankingPreview}}">
          <view class="participant-preview-head">
            <text class="participant-preview-title">{{preview.rankingTitle}}</text>
            <text class="participant-preview-meta">{{preview.progressText}}</text>
          </view>
          <view class="ranking-preview-list" wx:if="{{preview.rankingPreview.length}}">
            <view class="ranking-preview-row" wx:for="{{preview.rankingPreview}}" wx:key="rank">
              <text class="ranking-preview-rank">{{item.rank}}</text>
              <text class="ranking-preview-name">{{item.name}}</text>
              <text class="ranking-preview-meta">{{item.summaryText}}</text>
            </view>
          </view>
          <view class="share-empty-note" wx:else>暂无排名</view>
        </view>
      </view>

      <view class="card-inline-squad" wx:if="{{tournament.mode==='squad_doubles' && preview.joinAllowed && !preview.joined}}">
        <view class="chips squad-chooser">
          <view class="chip {{joinSquadChoice==='A' ? 'active' : ''}}" data-squad="A" bindtap="onPickJoinSquad">A队</view>
          <view class="chip {{joinSquadChoice==='B' ? 'active' : ''}}" data-squad="B" bindtap="onPickJoinSquad">B队</view>
        </view>
      </view>

      <view class="share-actions">
        <button
          class="btn btn-primary share-primary-btn"
          bindtap="onPrimaryAction"
          loading="{{joinBusy}}"
          disabled="{{joinBusy || preview.primaryAction.key==='identity_pending'}}"
        >{{preview.primaryAction.text}}</button>
      </view>
    </view>
  </block>

  <view class="share-error-panel reveal reveal-2" wx:if="{{loadError && !tournament}}">
    <view class="state-error">
      <view class="state-error-title">{{preview.headline}}</view>
      <view class="state-error-desc">{{preview.subtitle}}</view>
      <view class="share-error-actions">
        <button class="btn btn-primary" bindtap="onPrimaryAction">{{preview.primaryAction.text}}</button>
        <button
          class="btn btn-subtle"
          wx:if="{{preview.secondaryAction && (preview.viewMode==='invalid-match' || preview.viewMode==='retryable-error')}}"
          bindtap="onSecondaryAction"
        >{{preview.secondaryAction.text}}</button>
      </view>
    </view>
  </view>

  <view class="share-loading muted small" wx:if="{{!tournament && !loadError}}">正在读取比赛...</view>
</view>
