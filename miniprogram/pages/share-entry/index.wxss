.share-entry-page {
  padding-top: var(--space-page-y);
}

.share-hero {
  padding: var(--space-card-pad-lg);
  border-radius: 20rpx;
  background: var(--surface-card);
  box-shadow: none;
}

.hero-top {
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-section);
}

.share-title {
  flex: 1;
  min-width: 0;
  color: var(--neutral-950);
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: 0;
}

.share-pills {
  margin-top: var(--space-inline);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-tight);
}

.share-pill {
  color: var(--neutral-600);
  font-size: 23rpx;
}

.share-decision {
  margin-top: var(--space-card-pad-lg);
}

.share-identity-status {
  margin-bottom: var(--space-section);
  padding: var(--space-inline) var(--space-section);
  border-left: 4rpx solid var(--brand-500);
  background: var(--brand-50);
  color: var(--neutral-700);
  font-size: 24rpx;
  line-height: 1.45;
}

.share-identity-status.is-timeout {
  border-left-color: var(--warning-500, #F59E0B);
  background: #FFFBEB;
}

.share-state-preview {
  padding-bottom: var(--space-card-pad);
  border-bottom: 1rpx solid var(--neutral-200);
}

.participant-preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-section);
}

.participant-preview-title {
  color: var(--neutral-950);
  font-size: 28rpx;
  font-weight: 760;
}

.participant-preview-meta {
  color: var(--neutral-500);
  font-size: 22rpx;
}

.participant-avatar-row {
  margin-top: var(--space-section);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-tight);
}

.participant-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-100);
}

.participant-avatar-img {
  width: 68rpx;
  height: 68rpx;
}

.participant-avatar-text {
  color: var(--brand-700);
  font-size: 24rpx;
  font-weight: 800;
}

.participant-overflow,
.share-empty-note {
  color: var(--neutral-500);
  font-size: 22rpx;
}

.ranking-preview-list {
  margin-top: var(--space-tight);
}

.ranking-preview-row {
  min-height: 68rpx;
  display: flex;
  align-items: center;
  gap: var(--space-section);
  border-bottom: 1rpx solid var(--neutral-100);
}

.ranking-preview-rank {
  width: 42rpx;
  color: var(--brand-700);
  font-size: 24rpx;
  font-weight: 800;
}

.ranking-preview-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--neutral-950);
  font-size: 25rpx;
  font-weight: 700;
}

.ranking-preview-meta {
  flex: none;
  color: var(--neutral-500);
  font-size: 21rpx;
}

.card-inline-squad {
  margin-top: var(--space-section);
}

.squad-chooser {
  justify-content: center;
}

.share-actions {
  margin-top: var(--space-card-pad);
}

.share-primary-btn {
  width: 100%;
  margin: 0 !important;
}

.share-error-panel,
.share-loading {
  margin-top: var(--space-card-pad-lg);
}

.share-error-actions {
  margin-top: var(--space-card-pad);
  display: flex;
  flex-direction: column;
  gap: var(--space-tight);
}

.share-error-actions .btn {
  width: 100%;
  margin: 0 !important;
}

.share-loading {
  padding: 80rpx 0;
  text-align: center;
}
