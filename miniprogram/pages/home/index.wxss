/* ============================================================
   HOME — 赛事工作台首页
   ============================================================ */

.home-page {
  padding: var(--space-page-y) var(--space-page-x);
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

/* sync-banner: 继承全局 app.wxss 基类, 仅覆盖页面间距 */
.home-page > .sync-banner {
  margin-bottom: var(--space-inline);
}

/* --- Hero 紧凑工作台卡片 --- */
.hero-card {
  margin-top: 0;
  padding: 0;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(24, 179, 104, 0.12);
  background:
    radial-gradient(circle at 88% 12%, rgba(24, 179, 104, 0.16) 0%, rgba(24, 179, 104, 0.04) 30%, transparent 56%),
    linear-gradient(180deg, rgba(241, 252, 245, 0.99) 0%, rgba(255, 255, 255, 0.99) 58%, #ffffff 100%);
  box-shadow: var(--shadow-card);
}

.hero-grid {
  padding: var(--space-card-pad-lg);
  display: flex;
  align-items: center;
  gap: 0;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-env-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(24, 179, 104, 0.14);
  background: rgba(24, 179, 104, 0.08);
  color: var(--brand-700);
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.h-title {
  margin-top: 0;
  font-size: 40rpx;
  font-weight: 780;
  line-height: 1.2;
  letter-spacing: 0.3rpx;
  color: var(--neutral-950);
}

.hero-task-strip {
  margin-top: var(--space-inline);
  padding: var(--space-card-pad);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.hero-task-empty {
  padding-bottom: 16rpx;
}

.hero-task-label {
  font-size: 22rpx;
  color: var(--neutral-500);
}

.hero-task-name {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 780;
  color: var(--neutral-950);
}

.hero-task-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--neutral-700);
}

.hero-task-detail {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--neutral-500);
}

.hero-progress-wrap {
  margin-top: var(--space-tight);
  display: flex;
  align-items: center;
  gap: var(--space-inline);
}

.hero-progress-bar {
  flex: 1;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--neutral-100);
  overflow: hidden;
}

.hero-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand-500) 0%, #29c77a 100%);
  transition: width 0.4s ease;
}

.hero-progress-text {
  font-size: 21rpx;
  font-weight: 700;
  color: var(--neutral-500);
  flex-shrink: 0;
}

.hero-task-btn {
  margin-top: var(--space-inline);
  width: 100%;
  min-width: 0;
}

/* --- Section --- */
.section {
  margin-top: var(--space-section);
}

.section-head {
  margin: 0 2rpx var(--space-tight);
}

/* --- 排序/筛选工具栏 --- */
.toolbar-row {
  margin-top: var(--space-tight);
  padding: var(--space-tight) var(--space-panel-pad);
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border: 1rpx solid rgba(15, 23, 42, 0.07);
  border-radius: 18rpx;
  margin-bottom: 4rpx;
  box-shadow: var(--shadow-soft);
}

.sort-row {
  display: flex;
  align-items: center;
  gap: var(--space-tight);
  flex-wrap: wrap;
}

.sort-label {
  font-size: 22rpx;
  color: var(--neutral-500, #64748B);
  margin-right: 2rpx;
}

.sort-chip {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--neutral-200, #E2E8F0);
  background: var(--bg-surface, #FFFFFF);
  color: var(--neutral-700, #334155);
  font-size: 22rpx;
  font-weight: 600;
  transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
}

.sort-chip.active {
  background: var(--brand-50, #F1FCF5);
  border-color: rgba(24, 179, 104, 0.18);
  color: var(--brand-700, #0A6F43);
  font-weight: 700;
}

.filter-row {
  margin-top: var(--space-tight);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-tight);
}

.filter-chip {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--neutral-200, #E2E8F0);
  background: var(--bg-surface, #FFFFFF);
  color: var(--neutral-700, #334155);
  font-size: 22rpx;
  font-weight: 600;
  transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
}

.filter-chip.active {
  background: var(--brand-50, #F1FCF5);
  border-color: rgba(24, 179, 104, 0.18);
  color: var(--brand-700, #0A6F43);
  font-weight: 700;
}

/* --- 赛事列表卡 --- */
.swipe-row {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  margin-top: var(--space-tight);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  box-shadow: var(--shadow-soft);
  transition: transform 100ms ease, filter 100ms ease;
}

.swipe-row.card {
  padding: 0;
  margin-top: var(--space-tight);
}

.swipe-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  display: flex;
  justify-content: flex-end;
  z-index: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 100ms ease;
}

.swipe-actions.is-open {
  opacity: 1;
  pointer-events: auto;
}

.del-btn {
  width: 160rpx;
  background: linear-gradient(145deg, #EF5350, #E5484D);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 28rpx;
}

.swipe-content {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 100%;
  background: linear-gradient(180deg, #FFFFFF 0%, #F8FBF9 100%);
  will-change: transform;
  border-left: 6rpx solid transparent;
  transition: transform 100ms ease;
}

.swipe-content.tone-running {
  border-left-color: var(--brand-500, #18B368);
}

.swipe-content.tone-draft {
  border-left-color: var(--neutral-300, #CBD5E1);
}

.swipe-content.tone-finished {
  border-left-color: var(--warning, #D97706);
}

.swipe-content.tone-finished .t-card {
  background: linear-gradient(180deg, rgba(255, 250, 239, 0.92) 0%, rgba(255, 255, 255, 0.98) 58%);
}

.swipe-content.tone-missing,
.swipe-content.tone-unknown {
  border-left-color: var(--neutral-300, #CBD5E1);
}

.t-card {
  padding: var(--space-panel-pad) var(--space-card-pad);
}

.t-top {
  align-items: flex-start;
}

.t-title {
  font-size: 29rpx;
  font-weight: 740;
  color: var(--neutral-950, #0F172A);
}

.t-stats {
  margin-top: var(--space-tight);
  display: flex;
  gap: var(--space-tight);
  flex-wrap: wrap;
}

.pill {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  color: var(--neutral-700, #334155);
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.t-meta-row {
  margin-top: var(--space-tight);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-tight);
}

.t-time {
  min-width: 0;
  flex: 1;
  color: var(--neutral-500, #64748B);
}

.t-actions {
  min-width: 0;
  max-width: 48%;
  flex-shrink: 0;
  display: flex;
  justify-content: flex-end;
  gap: var(--space-tight);
}

.finished-growth-markers {
  margin-top: var(--space-tight);
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-tight);
}

.finished-growth-pill {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(245, 158, 11, 0.18);
  background: rgba(255, 250, 239, 0.92);
  color: #92400E;
  font-size: 21rpx;
  font-weight: 720;
  line-height: 1.3;
}

.finished-review-note {
  margin-top: 8rpx;
  padding: 8rpx 10rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(245, 158, 11, 0.12);
  color: var(--neutral-600, #475569);
  font-size: 22rpx;
  line-height: 1.35;
}

.t-copy-link,
.t-quick-action {
  min-width: 132rpx;
  min-height: 44rpx;
  max-width: 100%;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(24, 179, 104, 0.08);
  border: 1rpx solid rgba(24, 179, 104, 0.14);
  color: var(--brand-700, #0A6F43);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: background 100ms ease;
}

.home-page.density-comfortable .swipe-row,
.home-page.density-comfortable .swipe-row.card,
.home-page.density-comfortable .skeleton-card-wrap {
  margin-top: var(--space-inline);
}

.home-page.density-comfortable .t-card,
.home-page.density-comfortable .skeleton-card-wrap .skeleton-card {
  padding: var(--space-card-pad-lg);
}

.home-page.density-comfortable .t-meta-row,
.home-page.density-comfortable .t-stats {
  margin-top: var(--space-inline);
}

.t-quick-action {
  background: rgba(79, 123, 255, 0.10);
  border-color: rgba(79, 123, 255, 0.16);
  color: var(--info-500, #4F7BFF);
}

/* --- Skeleton 更拟真 --- */
.skeleton-list {
  margin-top: var(--space-tight);
}

.skeleton-card-wrap {
  margin-top: var(--space-tight);
  border-radius: 20rpx;
  border: 1rpx solid var(--neutral-200, #E2E8F0);
  overflow: hidden;
}

.skeleton-card-wrap .skeleton-card {
  margin-top: 0;
  padding: var(--space-panel-pad) var(--space-card-pad);
  border: none;
  border-left: 6rpx solid var(--neutral-200, #E2E8F0);
}

.skeleton-badge {
  width: 80rpx;
  height: 32rpx;
  border-radius: 999rpx;
}

/* --- Profile Nudge --- */
.profile-nudge {
  margin-top: 0;
  border-radius: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
}

.profile-nudge-actions {
  margin-top: var(--space-inline);
  display: flex;
  align-items: center;
  gap: var(--space-inline);
  min-width: 0;
}

.profile-nudge-actions .btn {
  flex: 1;
  width: 0;
  min-width: 0;
}

.profile-nudge-later {
  flex: none;
  font-size: 24rpx;
  color: var(--neutral-500, #64748B);
}

/* --- Onboarding --- */
.onboarding {
  margin-top: 0;
}

.guide-step {
  margin-top: var(--space-tight);
  display: flex;
  align-items: center;
  gap: var(--space-inline);
}

.guide-index {
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: var(--brand-50, #F1FCF5);
  color: var(--brand-700, #0A6F43);
  font-size: 22rpx;
  font-weight: 700;
}

.guide-text {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  color: var(--neutral-950, #0F172A);
}

.onboarding-later {
  margin-top: var(--space-inline);
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--neutral-500, #64748B);
}

/* --- Retry Box --- */
.retry-box {
  margin-top: var(--space-section);
  padding: var(--space-panel-pad) var(--space-card-pad);
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-inline);
}

/* --- Responsive --- */
@media (max-width: 360px) {
  .hero-grid {
    flex-direction: column;
  }

  .profile-nudge-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .toolbar-row {
    padding: 8rpx 10rpx;
  }
}
