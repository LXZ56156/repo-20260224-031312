<view class="container safe-bottom lobby-page {{uiMotionClass}}" wx:if="{{tournament}}">
  <view class="match-primary-nav">
    <view
      class="match-primary-nav-item {{item.active ? 'active' : ''}}"
      wx:for="{{primaryNavItems}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onPrimaryNavTap"
    >
      {{item.text}}
    </view>
  </view>

  <view class="sync-banner sync-{{syncStatusTone}}" hidden="{{!syncStatusVisible}}">
    <view class="sync-banner-main">
      <view class="sync-banner-text">{{syncStatusText}}</view>
      <view class="sync-banner-meta" wx:if="{{syncStatusMeta}}">{{syncStatusMeta}}</view>
    </view>
    <text class="sync-banner-action" bindtap="onRetry">{{syncStatusActionText}}</text>
  </view>

  <include src="./lobby-hero.wxml"/>

  <view class="sheet-mask" wx:if="{{showJoinSheet}}" bindtap="closeJoinSheet"></view>
  <include src="./lobby-join-sheet.wxml"/>
  <include src="./lobby-player-grid.wxml"/>
  <include src="./lobby-state-panel.wxml"/>
  <include src="./lobby-admin-panel.wxml"/>

  <view class="retry-box" wx:if="{{canRetryAction}}">
    <view class="muted small">{{lastFailedActionText}}</view>
    <button class="btn btn-subtle btn-sm" bindtap="retryLastAction">重试上次操作</button>
  </view>
</view>

<view class="container safe-bottom {{uiMotionClass}}" wx:elif="{{loadError}}">
  <view class="state-error">
    <view class="state-error-icon">⚠</view>
    <view class="state-error-title">{{loadErrorTitle}}</view>
    <view class="state-error-desc">{{loadErrorMessage}}</view>
    <view class="state-error-actions">
      <button class="btn btn-subtle btn-sm" bindtap="onRetry">重新加载</button>
      <button class="btn btn-ghost btn-sm" wx:if="{{showLoadErrorHome}}" bindtap="goHome">返回首页</button>
    </view>
  </view>
</view>

<view class="container lobby-page {{uiMotionClass}}" wx:else>
  <view class="skeleton-bone skeleton-hero reveal reveal-1"></view>
  <view class="skeleton-card reveal reveal-2">
    <view class="skeleton-bone skeleton-line skeleton-line-medium"></view>
    <view class="skeleton-bone skeleton-line skeleton-line-long"></view>
    <view class="skeleton-bone skeleton-line skeleton-line-short"></view>
  </view>
  <view class="skeleton-card reveal reveal-3">
    <view class="skeleton-row" style="margin-bottom: 16rpx;">
      <view class="skeleton-bone skeleton-line skeleton-line-short" style="margin-bottom: 0;"></view>
      <view class="skeleton-bone skeleton-pill"></view>
    </view>
    <view class="skeleton-row" style="gap: 12rpx;">
      <view class="skeleton-bone skeleton-circle"></view>
      <view class="skeleton-bone skeleton-circle"></view>
      <view class="skeleton-bone skeleton-circle"></view>
      <view class="skeleton-bone skeleton-circle"></view>
    </view>
  </view>
</view>
