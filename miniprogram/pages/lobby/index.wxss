/* ============================================================
   LOBBY — 赛事大厅控制台
   轻专业赛事中控台风 · 8pt grid · Design System v2 tokens
   ============================================================ */

/* --- Layout --- */
.container.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

.lobby-page {
  padding-top: var(--space-page-y);
}

/* --- Tournament summary --- */
.lobby-page .hero {
  margin-bottom: 0;
  padding: var(--space-hero-pad-y) var(--space-hero-pad-x);
  border-radius: 20rpx;
  background: var(--surface-card);
  border: 1rpx solid rgba(24, 179, 104, 0.12);
  box-shadow: none;
}

.hero-top {
  justify-content: space-between;
  align-items: flex-start;
  gap: var(--space-section);
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 0;
  line-height: 1.3;
  color: var(--neutral-950);
  overflow-wrap: anywhere;
}

.hero-sub {
  margin-top: var(--space-tight);
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--neutral-500);
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-tight);
  margin-top: var(--space-inline);
}

.hero-meta-pill {
  min-height: 44rpx;
  padding: 4rpx 12rpx;
  background: rgba(241, 252, 245, 0.96);
  border-color: rgba(24, 179, 104, 0.12);
  font-size: 21rpx;
  color: var(--brand-700);
}

.hero-role {
  color: var(--brand-700);
  font-weight: 700;
}

.hero-status-tag {
  margin-top: 2rpx;
  box-shadow: none;
}

.hero-status-tag.tag-draft {
  background: rgba(239, 251, 243, 0.96);
  border-color: rgba(24, 179, 104, 0.16);
  color: var(--brand-700);
}

.hero-status-tag.tag-running {
  background: rgba(24, 179, 104, 0.12);
  border-color: rgba(24, 179, 104, 0.18);
  color: var(--brand-700);
}

/* --- Next action --- */
.lobby-next {
  margin-top: var(--space-section);
  padding: var(--space-card-pad-lg) var(--space-card-pad);
  border-top: 1rpx solid var(--neutral-200);
  border-bottom: 1rpx solid var(--neutral-200);
}

.lobby-next-copy {
  margin-top: var(--space-tight);
  line-height: 1.5;
}

.state-actions {
  margin-top: var(--space-section);
}

.state-primary-btn {
  margin-top: 0 !important;
  width: 100%;
  min-width: 0;
  border-radius: 16rpx;
  box-shadow: none;
}

/* --- Section common --- */
.section-title {
  font-size: 30rpx;
  font-weight: 740;
}

.row-right {
  display: flex;
  align-items: center;
  gap: var(--space-inline);
}

.link-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--brand-600);
  font-weight: 700;
  font-size: 25rpx;
  padding: 0 10rpx;
  min-height: 48rpx;
  border-radius: 12rpx;
}

/* --- Player Grid --- */
.player-grid {
  margin-top: var(--space-section);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-section) var(--space-inline);
}

.player-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-tight);
}

.player-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

.player-avatar-img {
  width: 88rpx;
  height: 88rpx;
}

.player-initial {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.player-name {
  width: 100%;
  font-size: 24rpx;
  color: var(--neutral-950);
  font-weight: 700;
  text-align: center;
}

.player-gender {
  font-size: 22rpx;
  color: var(--neutral-500);
}

/* Player grid empty state */
.player-grid-empty {
  margin-top: var(--space-section);
  padding: var(--space-page-bottom) var(--space-section);
  border-radius: 16rpx;
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border: 1rpx dashed rgba(148, 163, 184, 0.24);
  text-align: center;
}

.player-grid-empty-text {
  font-size: 25rpx;
  color: var(--neutral-500);
  font-weight: 600;
}

/* --- Profile Panel --- */
.profile-panel {
  padding-top: var(--space-card-pad);
  background: linear-gradient(180deg, rgba(249, 255, 252, 0.98) 0%, rgba(255, 255, 255, 0.99) 100%);
  border-color: rgba(24, 179, 104, 0.1);
}

.profile-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border: 2rpx solid var(--neutral-200);
}

.profile-input {
  margin-top: var(--space-inline);
  text-align: center;
  padding-left: 0;
  padding-right: 0;
}

.profile-inline-tip {
  margin-top: var(--space-tight);
}

.profile-actions-center {
  width: 100%;
  justify-content: center;
  margin-top: var(--space-inline);
  margin-bottom: var(--space-inline);
}

.profile-actions-center .btn-mini {
  min-width: 220rpx;
  background: rgba(255, 255, 255, 0.94);
}

.profile-actions-center .profile-quick-btn {
  background: linear-gradient(135deg, var(--brand-500), var(--brand-600));
  color: #ffffff;
}

/* --- Join trigger bar --- */
.join-trigger-bar {
  margin-bottom: 0;
}

/* --- Bottom-sheet --- */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.join-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(245, 251, 247, 0.98) 0%, rgba(255, 255, 255, 0.99) 24%, #ffffff 100%);
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 28rpx 28rpx 0 0;
  padding: var(--space-section) 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -8rpx 30rpx rgba(15, 23, 42, 0.12);
  max-height: 80vh;
  overflow-y: auto;
}

.join-sheet.sheet-open {
  transform: translateY(0);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--neutral-300);
  margin: 0 auto var(--space-card-pad-lg);
}

/* --- Admin Panel (visually demoted) --- */
.admin-panel {
  margin-top: var(--space-section);
  padding: var(--space-card-pad) 0 0;
  border-top: 1rpx solid var(--neutral-200);
}

.admin-section-title {
  color: var(--neutral-500);
  font-size: 26rpx;
}

.admin-collapse-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.admin-collapse-arrow {
  font-size: 24rpx;
  color: var(--neutral-500);
  transition: transform 0.2s;
}

.admin-collapse-arrow.expanded {
  transform: rotate(180deg);
}

.admin-manage-actions {
  margin-top: var(--space-section);
  display: flex;
  min-width: 0;
  gap: var(--space-inline);
}

.admin-manage-actions .btn {
  border-radius: 16rpx;
  margin-top: 0 !important;
  flex: 1;
  width: 0;
  min-width: 0;
}

.admin-manage-actions .btn[disabled] {
  opacity: 0.72;
  filter: saturate(0.7);
}

.player-roster-hint {
  font-size: 22rpx;
  color: var(--neutral-500);
}

/* --- Quick Import --- */
.quick-import {
  margin-top: var(--space-section);
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.8);
  padding: var(--space-panel-pad);
}

.quick-import-head {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--neutral-950);
}

.quick-import-input {
  margin-top: var(--space-tight);
  min-height: 160rpx;
}

.quick-import-actions {
  margin-top: var(--space-inline);
}

.quick-import-result {
  margin-top: var(--space-inline);
  padding: var(--space-inline);
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.07);
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
}

.quick-import-result-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--neutral-950);
}

/* --- Fixed Team (pair mode) --- */
.fixed-team {
  margin-top: var(--space-section);
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.8);
  padding: var(--space-panel-pad);
}

.fixed-team-head {
  align-items: center;
}

.fixed-team-list {
  margin-top: var(--space-tight);
  display: flex;
  flex-direction: column;
  gap: var(--space-tight);
}

.fixed-team-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-inline);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.94);
  padding: 10rpx 12rpx;
}

.fixed-team-main {
  flex: 1;
  min-width: 0;
}

.fixed-team-name {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--neutral-950);
}

.fixed-team-create {
  margin-top: var(--space-inline);
}

.fixed-team-name-input {
  margin-bottom: var(--space-tight);
}

.fixed-team-create-btn {
  margin-top: var(--space-inline);
}

/* --- Primary task summary --- */
.primary-task-summary {
  margin-bottom: var(--space-tight);
}

/* --- Unpaired players hint --- */
.unpaired-hint {
  margin-top: var(--space-inline);
  padding: var(--space-inline) var(--space-panel-pad);
  border-radius: 14rpx;
  border: 1rpx solid #FECDD3;
  background: #FFF1F2;
}

.unpaired-hint-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #9F1239;
}

.unpaired-hint-text {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #BE123C;
  line-height: 1.45;
}

/* --- Quick Settings --- */
.quick-settings {
  margin-top: var(--space-section);
  margin-bottom: var(--space-section);
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.8);
  padding: var(--space-panel-pad);
}

.quick-settings-head {
  align-items: center;
}

.quick-settings-title {
  font-size: 26rpx;
}

.quick-settings-pill {
  background: rgba(255, 255, 255, 0.92);
}

.quick-settings-hint {
  margin-top: var(--space-tight);
}

.quick-settings-form {
  margin-top: var(--space-inline);
}

.quick-settings-form.quick-settings-disabled {
  opacity: 0.8;
}

.quick-settings-field {
  margin-bottom: var(--space-tight);
}

.quick-settings-input.disabled,
.quick-settings-input[disabled],
.quick-config-picker.disabled {
  background: rgba(248, 250, 252, 0.96);
  color: var(--neutral-500);
}

.quick-settings-meta {
  margin-top: 0;
}

.quick-settings-summary {
  margin-top: var(--space-inline);
  padding: var(--space-inline) var(--space-panel-pad);
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
}

.quick-match-shortcuts {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-tight);
}

.quick-match-shortcut {
  box-sizing: border-box;
  min-width: calc((100% - 8rpx) / 2);
  text-align: center;
}

.quick-custom-match-card {
  margin-top: var(--space-inline);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.94);
  overflow: hidden;
}

.quick-custom-match-head {
  min-height: 64rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quick-custom-match-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--neutral-800);
}

.quick-custom-match-action {
  box-sizing: border-box;
  flex: 0 0 88rpx;
  width: 88rpx;
  min-width: 0;
  max-width: 88rpx;
  margin-left: 0;
  margin-right: 0;
  height: 48rpx;
  padding: 0 12rpx;
  border: 0;
  border-radius: 24rpx;
  background: rgba(18, 166, 100, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--brand-700);
}

.quick-custom-match-action::after {
  border: 0;
}
.quick-custom-match-body {
  padding: var(--space-inline) var(--space-panel-pad);
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
  display: flex;
  align-items: center;
  gap: var(--space-inline);
  background: rgba(248, 250, 252, 0.72);
}

.quick-custom-match-label {
  flex: 0 0 auto;
  min-width: 72rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--neutral-500);
}

.quick-custom-match-picker-wrap {
  flex: 1;
}

.quick-custom-match-value {
  box-sizing: border-box;
  height: 60rpx;
  padding: 0 18rpx;
  border-radius: 10rpx;
  border: 1rpx solid rgba(18, 166, 100, 0.18);
  background: #FFFFFF;
  color: var(--neutral-800);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 60rpx;
  text-align: right;
}

.quick-match-shortcut.disabled {
  background: rgba(248, 250, 252, 0.96);
  border-color: rgba(148, 163, 184, 0.2);
  color: var(--neutral-500);
}

.quick-match-shortcut.disabled:active {
  transform: none;
  filter: none;
}

.quick-settings-save {
  margin-top: var(--space-inline);
}

/* --- Quick Config (picker) --- */
.quick-config-row {
  margin-top: var(--space-tight);
  display: flex;
  gap: var(--space-inline);
}

.quick-config-col {
  width: calc((100% - 12rpx) / 2);
}

.quick-config-label {
  margin-bottom: var(--space-tight);
  color: var(--neutral-500);
  font-size: 24rpx;
}

.quick-config-picker {
  min-height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.98);
  padding: 0 18rpx;
  font-size: 30rpx;
  color: var(--neutral-950);
}

/* --- Loading / Error --- */
.loading-title {
  font-size: 32rpx;
  font-weight: 760;
  margin-bottom: var(--space-tight);
}

/* --- Responsive --- */
@media (max-width: 360px) {
  .player-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
