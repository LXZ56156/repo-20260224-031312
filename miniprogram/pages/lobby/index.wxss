/* ============================================================
   LOBBY — 赛事大厅控制台
   轻专业赛事中控台风 · 8pt grid · Design System v2 tokens
   ============================================================ */

/* --- Layout --- */
.container.safe-bottom {
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
}

.lobby-page {
  padding-top: 16rpx;
}

/* --- Hero (compact console style) --- */
.lobby-page .hero {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 88% 12%, rgba(78, 214, 145, 0.18) 0%, rgba(78, 214, 145, 0.05) 30%, transparent 56%),
    linear-gradient(180deg, rgba(241, 253, 245, 0.99) 0%, rgba(253, 255, 254, 0.99) 58%, #ffffff 100%);
  border: 1rpx solid rgba(24, 179, 104, 0.14);
  box-shadow: 0 12rpx 32rpx rgba(24, 179, 104, 0.12);
}

.lobby-page .hero.hero-draft {
  background:
    radial-gradient(circle at 88% 12%, rgba(107, 221, 160, 0.18) 0%, rgba(107, 221, 160, 0.05) 30%, transparent 56%),
    linear-gradient(180deg, rgba(244, 254, 248, 0.99) 0%, rgba(253, 255, 254, 0.99) 58%, #ffffff 100%);
  border-color: rgba(24, 179, 104, 0.16);
  box-shadow: 0 12rpx 32rpx rgba(24, 179, 104, 0.10);
}

.lobby-page .hero.hero-finished {
  background:
    radial-gradient(circle at 88% 12%, rgba(245, 158, 11, 0.16) 0%, rgba(245, 158, 11, 0.04) 30%, transparent 56%),
    linear-gradient(180deg, rgba(255, 250, 240, 0.99) 0%, rgba(255, 255, 255, 0.99) 58%, #ffffff 100%);
  border-color: rgba(245, 158, 11, 0.16);
  box-shadow: var(--shadow-card);
}

.hero-top {
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 820;
  letter-spacing: -0.3rpx;
  line-height: 1.2;
  color: var(--neutral-950);
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--neutral-500);
}

.hero-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.hero-meta-pill {
  min-height: 44rpx;
  padding: 4rpx 12rpx;
  background: rgba(241, 252, 245, 0.96);
  border-color: rgba(24, 179, 104, 0.12);
  font-size: 21rpx;
  color: var(--brand-700);
}

.hero-status-tag {
  margin-top: 2rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.92);
}

.hero-status-tag.tag-draft {
  background: rgba(239, 251, 243, 0.96);
  border-color: rgba(24, 179, 104, 0.16);
  color: var(--brand-700);
}

.hero-status-tag.tag-running {
  background: rgba(24, 179, 104, 0.12);
  border-color: rgba(24, 179, 104, 0.18);
  color: var(--brand-700);
}

.hero-context {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, rgba(249, 255, 252, 0.94) 0%, rgba(240, 252, 245, 0.96) 100%);
  border: 1rpx solid rgba(24, 179, 104, 0.1);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.96), 0 8rpx 20rpx rgba(24, 179, 104, 0.06);
}

.hero-context-summary {
  font-size: 28rpx;
  font-weight: 760;
  line-height: 1.45;
  color: var(--neutral-950);
}

.hero-context-meta {
  margin-top: 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}

.hero-context-text {
  font-size: 22rpx;
  line-height: 1.45;
  color: var(--neutral-700);
}

.hero-stats {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.hero-stat {
  padding: 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(243, 253, 247, 0.96) 100%);
  border: 1rpx solid rgba(24, 179, 104, 0.1);
  box-shadow: 0 6rpx 16rpx rgba(24, 179, 104, 0.06);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.hero-stat-label {
  font-size: 22rpx;
  color: var(--brand-700);
}

.hero-stat-value {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: -0.3rpx;
  color: var(--neutral-950);
}

/* --- State Overview (primary action rail) --- */
.state-overview {
  border-color: rgba(24, 179, 104, 0.18);
  background:
    radial-gradient(circle at 85% 8%, rgba(126, 235, 179, 0.22) 0%, rgba(126, 235, 179, 0.06) 26%, transparent 52%),
    linear-gradient(180deg, rgba(240, 252, 245, 0.99) 0%, rgba(255, 255, 255, 0.99) 42%, rgba(246, 254, 249, 0.99) 100%);
  box-shadow: 0 14rpx 34rpx rgba(24, 179, 104, 0.12);
  overflow: hidden;
}

.state-overview .count-pill {
  background: rgba(255, 255, 255, 0.9);
  border-color: rgba(24, 179, 104, 0.14);
  color: var(--brand-700);
}

.state-panel-summary {
  margin-top: 8rpx;
  font-size: 29rpx;
  line-height: 1.46;
  color: var(--neutral-950);
  font-weight: 700;
}

.state-checklist {
  margin-top: 16rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(24, 179, 104, 0.08);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.74) 0%, rgba(245, 254, 248, 0.9) 100%);
  display: block;
}

.state-actions {
  margin-top: 18rpx;
}

.state-primary-btn {
  margin-top: 0 !important;
  width: 78%;
  min-width: 0;
  margin-left: auto !important;
  margin-right: auto !important;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #29C977 0%, #18B368 52%, #0E8F55 100%) !important;
  box-shadow: 0 12rpx 24rpx rgba(24, 179, 104, 0.24);
}

/* start button sticky */
.state-actions-sticky {
  position: sticky;
  bottom: calc(env(safe-area-inset-bottom) + 12rpx);
  z-index: 9;
  padding: 12rpx;
  margin: 0 -16rpx;
  background: rgba(247, 254, 250, 0.97);
  border-radius: 20rpx;
  border: 1rpx solid rgba(24, 179, 104, 0.08);
  box-shadow: 0 -4rpx 18rpx rgba(24, 179, 104, 0.08);
}

.start-pulse {
  animation: startPulse 1.6s ease-in-out infinite;
}

@keyframes startPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(20, 128, 75, 0.3); }
  50% { box-shadow: 0 0 0 12rpx rgba(20, 128, 75, 0); }
}

/* --- Checklist cards --- */
.prep-featured,
.prep-tile {
  border-radius: 16rpx;
  border: 1rpx solid rgba(24, 179, 104, 0.08);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(247, 254, 250, 0.97) 100%);
}

.prep-featured {
  padding: 18rpx;
  box-shadow: 0 10rpx 24rpx rgba(24, 179, 104, 0.07);
}

.prep-featured:active,
.prep-tile:active {
  transform: translateY(1rpx);
}

.prep-secondary-grid {
  display: flex;
  gap: 10rpx;
  margin-top: 8rpx;
}

.prep-tile {
  flex: 1;
  min-height: 152rpx;
  padding: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10rpx;
}

.prep-card-active {
  border-color: rgba(24, 179, 104, 0.18);
  background: linear-gradient(180deg, rgba(239, 252, 244, 0.99) 0%, rgba(255, 255, 255, 0.99) 100%);
  box-shadow: 0 10rpx 26rpx rgba(24, 179, 104, 0.16);
}

.prep-card-done {
  border-color: rgba(24, 179, 104, 0.1);
  background: linear-gradient(180deg, rgba(247, 253, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
}

.prep-card-pending {
  border-color: rgba(24, 179, 104, 0.08);
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.97) 0%, rgba(250, 253, 251, 0.97) 100%);
}

.prep-featured-top,
.prep-secondary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.prep-featured-top {
  margin-bottom: 12rpx;
}

.prep-featured-main {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.prep-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(181, 225, 199, 0.8);
  flex: none;
}

.prep-indicator-lg {
  width: 20rpx;
  height: 20rpx;
  margin-top: 8rpx;
}

.prep-indicator-ok {
  background: #24C274;
}

.prep-indicator-active {
  background: #22C06F;
  box-shadow: 0 0 0 10rpx rgba(24, 179, 104, 0.12);
}

.prep-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: rgba(36, 194, 116, 0.12);
  border: 1rpx solid rgba(24, 179, 104, 0.1);
  color: var(--brand-700);
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.prep-badge-subtle {
  min-height: 32rpx;
  padding: 0 10rpx;
  background: rgba(242, 251, 245, 0.9);
  border-color: rgba(24, 179, 104, 0.08);
  color: var(--brand-700);
}

.prep-main {
  flex: 1;
  min-width: 0;
}

.prep-main-secondary {
  min-height: 0;
}

.prep-title {
  font-size: 24rpx;
  color: var(--neutral-950);
  font-weight: 700;
}

.prep-title-featured {
  font-size: 28rpx;
}

.prep-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--neutral-500);
  line-height: 1.45;
}

.prep-sub-featured {
  font-size: 24rpx;
}

.prep-jump {
  font-size: 22rpx;
  color: #0FA45E;
  font-weight: 760;
  white-space: nowrap;
}

.prep-jump-featured {
  font-size: 24rpx;
}

.prep-tile .prep-jump {
  margin-top: auto;
}

/* --- Section common --- */
.section-title {
  font-size: 30rpx;
  font-weight: 740;
}

.row-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.link-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  color: var(--brand-600);
  font-weight: 700;
  font-size: 25rpx;
  padding: 0 10rpx;
  min-height: 48rpx;
  border-radius: 12rpx;
}

/* --- Player Grid --- */
.player-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx 12rpx;
}

.player-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.player-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

.player-avatar-img {
  width: 88rpx;
  height: 88rpx;
}

.player-initial {
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.player-name {
  width: 100%;
  font-size: 24rpx;
  color: var(--neutral-950);
  font-weight: 700;
  text-align: center;
}

.player-gender {
  font-size: 22rpx;
  color: var(--neutral-500);
}

/* Player grid empty state */
.player-grid-empty {
  margin-top: 16rpx;
  padding: 32rpx 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border: 1rpx dashed rgba(148, 163, 184, 0.24);
  text-align: center;
}

.player-grid-empty-text {
  font-size: 25rpx;
  color: var(--neutral-500);
  font-weight: 600;
}

/* --- Profile Panel --- */
.profile-panel {
  padding-top: 20rpx;
  background: linear-gradient(180deg, rgba(249, 255, 252, 0.98) 0%, rgba(255, 255, 255, 0.99) 100%);
  border-color: rgba(24, 179, 104, 0.1);
}

.profile-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  border: 2rpx solid var(--neutral-200);
}

.profile-input {
  margin-top: 12rpx;
  text-align: center;
  padding-left: 0;
  padding-right: 0;
}

.profile-inline-tip {
  margin-top: 8rpx;
}

.profile-actions-center {
  width: 100%;
  justify-content: center;
  margin-top: 12rpx;
  margin-bottom: 12rpx;
}

.profile-actions-center .btn-mini {
  min-width: 220rpx;
  background: rgba(255, 255, 255, 0.94);
}

.profile-actions-center .profile-quick-btn {
  background: linear-gradient(135deg, var(--brand-500), var(--brand-600));
  color: #ffffff;
}

/* --- Join trigger bar --- */
.join-trigger-bar {
  margin-bottom: 16rpx;
}

.join-trigger-btn {
  margin-top: 0 !important;
  width: 78%;
  min-width: 0;
  margin-left: auto !important;
  margin-right: auto !important;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #29C977 0%, #18B368 52%, #0E8F55 100%) !important;
  box-shadow: 0 12rpx 24rpx rgba(24, 179, 104, 0.22);
}

/* --- Bottom-sheet --- */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.join-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(245, 251, 247, 0.98) 0%, rgba(255, 255, 255, 0.99) 24%, #ffffff 100%);
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 28rpx 28rpx 0 0;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
  box-shadow: 0 -8rpx 30rpx rgba(15, 23, 42, 0.12);
  max-height: 80vh;
  overflow-y: auto;
}

.join-sheet.sheet-open {
  transform: translateY(0);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--neutral-300);
  margin: 0 auto 20rpx;
}

/* --- Share bar (low-profile inline) --- */
.share-bar {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, rgba(245, 252, 247, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border: 1rpx solid rgba(24, 179, 104, 0.14);
  box-shadow: var(--shadow-soft);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.share-bar-left {
  flex: 1;
  min-width: 0;
}

.share-bar-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-700);
}

.share-bar-badge {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--neutral-500);
}

.share-bar-btn {
  flex-shrink: 0;
  width: auto !important;
  min-width: 144rpx;
}

.share-pulse {
  animation: sharePulse 700ms ease-in-out 2;
}

@keyframes sharePulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.03); }
  100% { transform: scale(1); }
}

/* --- Info panel (demoted) --- */
.info-panel {
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border-color: rgba(15, 23, 42, 0.07);
}

.rule-chips {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.rule-chip {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  color: var(--neutral-700);
  font-size: 22rpx;
  font-weight: 600;
}

.info-highlight {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(24, 179, 104, 0.14);
  background: rgba(255, 255, 255, 0.94);
  color: var(--neutral-950);
  font-size: 26rpx;
  font-weight: 700;
}

/* --- Admin Panel (visually demoted) --- */
.admin-panel {
  background: linear-gradient(180deg, rgba(249, 251, 252, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  border-color: rgba(148, 163, 184, 0.18);
  border-style: dashed;
}

.admin-section-title {
  color: var(--neutral-500);
  font-size: 26rpx;
}

.admin-collapse-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.admin-collapse-arrow {
  font-size: 24rpx;
  color: var(--neutral-500);
  transition: transform 0.2s;
}

.admin-collapse-arrow.expanded {
  transform: rotate(180deg);
}

.admin-manage-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.admin-manage-actions .btn {
  border-radius: 16rpx;
  margin-top: 0 !important;
  flex: 1;
}

.admin-manage-actions .btn[disabled] {
  opacity: 0.72;
  filter: saturate(0.7);
}

/* --- Quick Import --- */
.quick-import {
  margin-top: 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.8);
  padding: 14rpx;
}

.quick-import-head {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--neutral-950);
}

.quick-import-input {
  margin-top: 8rpx;
  min-height: 160rpx;
}

.quick-import-actions {
  margin-top: 12rpx;
}

.quick-import-result {
  margin-top: 12rpx;
  padding: 12rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.07);
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
}

.quick-import-result-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--neutral-950);
}

/* --- Fixed Team (pair mode) --- */
.fixed-team {
  margin-top: 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.8);
  padding: 14rpx;
}

.fixed-team-head {
  align-items: center;
}

.fixed-team-list {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.fixed-team-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.94);
  padding: 10rpx 12rpx;
}

.fixed-team-main {
  flex: 1;
  min-width: 0;
}

.fixed-team-name {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--neutral-950);
}

.fixed-team-create {
  margin-top: 12rpx;
}

.fixed-team-name-input {
  margin-bottom: 8rpx;
}

.fixed-team-create-btn {
  margin-top: 12rpx;
}

/* --- Primary task summary --- */
.primary-task-summary {
  margin-bottom: 8rpx;
}

/* --- Unpaired players hint --- */
.unpaired-hint {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  border: 1rpx solid #FECDD3;
  background: #FFF1F2;
}

.unpaired-hint-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #9F1239;
}

.unpaired-hint-text {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #BE123C;
  line-height: 1.45;
}

/* --- Quick Settings --- */
.quick-settings {
  margin-top: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.8);
  padding: 14rpx;
}

.quick-settings-head {
  align-items: center;
}

.quick-settings-title {
  font-size: 26rpx;
}

.quick-settings-pill {
  background: rgba(255, 255, 255, 0.92);
}

.quick-settings-hint {
  margin-top: 8rpx;
}

.quick-settings-form {
  margin-top: 14rpx;
}

.quick-settings-form.quick-settings-disabled {
  opacity: 0.8;
}

.quick-settings-field {
  margin-bottom: 8rpx;
}

.quick-settings-input.disabled,
.quick-settings-input[disabled],
.quick-config-picker.disabled {
  background: rgba(248, 250, 252, 0.96);
  color: var(--neutral-500);
}

.quick-settings-meta {
  margin-top: 0;
}

.quick-settings-summary {
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  background: linear-gradient(180deg, rgba(248, 252, 249, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
}

.quick-match-shortcuts {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.quick-match-shortcut {
  box-sizing: border-box;
  min-width: calc((100% - 10rpx) / 2);
  text-align: center;
}

.quick-match-shortcut.disabled {
  background: rgba(248, 250, 252, 0.96);
  border-color: rgba(148, 163, 184, 0.2);
  color: var(--neutral-500);
}

.quick-match-shortcut.disabled:active {
  transform: none;
  filter: none;
}

.quick-settings-save {
  margin-top: 12rpx;
}

/* --- Quick Config (picker) --- */
.quick-config-row {
  margin-top: 8rpx;
  display: flex;
  gap: 12rpx;
}

.quick-config-col {
  width: calc((100% - 12rpx) / 2);
}

.quick-config-label {
  margin-bottom: 8rpx;
  color: var(--neutral-500);
  font-size: 24rpx;
}

.quick-config-picker {
  min-height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  background: rgba(255, 255, 255, 0.98);
  padding: 0 18rpx;
  font-size: 30rpx;
  color: var(--neutral-950);
}

/* --- Loading / Error --- */
.loading-title {
  font-size: 32rpx;
  font-weight: 760;
  margin-bottom: 8rpx;
}

/* --- Player color palette --- */
.pcolor-0 { background: var(--brand-500); }
.pcolor-1 { background: #0ea5e9; }
.pcolor-2 { background: #f59e0b; }
.pcolor-3 { background: #8b5cf6; }
.pcolor-4 { background: #ef4444; }
.pcolor-5 { background: #14b8a6; }

/* --- Responsive --- */
@media (max-width: 360px) {
  .prep-secondary-grid {
    flex-direction: column;
  }

  .player-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
