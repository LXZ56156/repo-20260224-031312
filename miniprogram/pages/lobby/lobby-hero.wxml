<view class="hero {{heroGradientClass}} reveal reveal-1">
    <view class="row hero-top">
      <view class="flex-1 minw0 hero-main">
        <view class="hero-title ellipsis">{{tournament.name}}</view>
        <view class="hero-sub">{{modeLabel}}</view>
        <view class="hero-meta" wx:if="{{isAdmin || myJoined}}">
          <text class="count-pill hero-meta-pill" wx:if="{{isAdmin}}">管理员</text>
          <text class="count-pill hero-meta-pill" wx:if="{{myJoined}}">已参赛</text>
        </view>
      </view>
      <view class="tag {{statusClass}} hero-status-tag">{{statusText}}</view>
    </view>

    <view class="hero-context">
      <view class="hero-context-summary">{{matchInfoText}}</view>
      <view class="hero-context-meta">
        <text class="hero-context-text">{{genderSummaryText}}</text>
        <text class="hero-context-text" wx:if="{{tournament.createdAt}}">创建 {{createdAtText}}</text>
      </view>
    </view>

    <view class="hero-stats">
      <view class="hero-stat">
        <text class="hero-stat-label">人数</text>
        <text class="hero-stat-value">{{kpiPlayers}}</text>
      </view>
      <view class="hero-stat">
        <text class="hero-stat-label">场次</text>
        <text class="hero-stat-value">{{kpiMatches}}</text>
      </view>
      <view class="hero-stat">
        <text class="hero-stat-label">场地</text>
        <text class="hero-stat-value">{{kpiCourts}}</text>
      </view>
    </view>
  </view>
