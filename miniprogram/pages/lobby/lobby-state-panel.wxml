<view class="lobby-next reveal reveal-3" wx:if="{{statePanelSummary || primaryTaskTitle || statePrimaryActionText}}">
  <view class="lobby-next-copy">
    <view class="section-title">{{statePanelTitle}}</view>
    <view class="muted small">{{primaryTaskSummary || statePanelSummary}}</view>
  </view>
  <view id="state-primary-action" class="state-actions" wx:if="{{primaryTaskTitle || statePrimaryActionText}}">
    <button
      wx:if="{{primaryTaskKey==='share'}}"
      class="btn btn-primary state-primary-btn"
      open-type="share"
      disabled="{{dynamicSharePreparing || (!dynamicShareReady && !dynamicShareError && !dynamicShareUnavailableReason)}}"
      bindtouchstart="onShareButtonTouchStart"
    >{{primaryTaskTitle || statePrimaryActionText}}</button>
    <button
      wx:else
      class="btn btn-primary state-primary-btn"
      bindtap="onNextActionTap"
    >{{primaryTaskTitle || statePrimaryActionText}}</button>
  </view>
</view>
