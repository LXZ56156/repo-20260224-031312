<view id="player-roster" class="card panel lobby-roster reveal reveal-2">
    <view class="section-head">
      <view class="section-title">参赛名单</view>
      <view class="row-right">
        <text class="player-roster-hint" wx:if="{{playerRosterHint}}">{{playerRosterHint}}</text>
        <text class="link-btn" wx:if="{{showMyProfile}}" bindtap="openJoinSheet">编辑资料</text>
        <text class="count-pill">{{playerCountText}}</text>
        <text class="link-btn" wx:if="{{tournament.players.length>12}}" bindtap="togglePlayers">{{showAllPlayers?'收起':'展开'}}</text>
      </view>
    </view>
    <view class="player-grid" wx:if="{{displayPlayers.length}}">
      <view class="player-cell" wx:for="{{displayPlayers}}" wx:key="id" data-player="{{item.id}}" data-name="{{item.name}}" bindtap="onTogglePlayerSquad" bindlongpress="onPlayerLongPress">
        <view class="player-avatar {{item.colorClass}}">
          <image class="player-avatar-img" wx:if="{{item.avatarDisplay}}" src="{{item.avatarDisplay}}" mode="aspectFill" data-avatar-raw="{{item.avatarRaw}}" binderror="onDisplayPlayerAvatarError"></image>
          <text class="player-initial" wx:else>{{item.initial}}</text>
        </view>
        <view class="player-name ellipsis">{{item.name}}</view>
        <view class="player-gender">{{item.genderLabel}}</view>
        <view class="player-gender" wx:if="{{mode==='squad_doubles'}}">{{item.squad ? item.squad + '队' : '未分队'}}</view>
      </view>
    </view>
    <view class="player-grid-empty" wx:else>
      <view class="player-grid-empty-text">暂无参赛者，分享邀请好友加入</view>
    </view>
  </view>
