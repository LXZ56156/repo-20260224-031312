/* Schedule 页面样式 — 赛事中控台风 */

.schedule-page {
  padding-top: 24rpx;
}

/* --- Hero 重构：表面优先的赛事状态卡 --- */
.schedule-page .hero {
  padding: 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(24, 179, 104, 0.12);
  background:
    radial-gradient(circle at 88% 12%, rgba(24, 179, 104, 0.14) 0%, rgba(24, 179, 104, 0.03) 30%, transparent 54%),
    linear-gradient(180deg, rgba(241, 252, 245, 0.98) 0%, rgba(255, 255, 255, 0.98) 52%, #ffffff 100%);
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
  color: var(--neutral-950);
}

.hero-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-kicker {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--neutral-500);
  letter-spacing: 0.3rpx;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.3rpx;
  color: var(--neutral-950);
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--neutral-500);
}

.hero-status {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 52rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.hero-status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: currentColor;
  flex: none;
}

.hero-status-running {
  background: rgba(24, 179, 104, 0.12);
  border: 1rpx solid rgba(24, 179, 104, 0.18);
  color: var(--brand-700);
}

.hero-status-draft {
  background: var(--neutral-100);
  border: 1rpx solid var(--neutral-200);
  color: var(--neutral-700);
}

.hero-status-finished {
  background: var(--brand-50);
  border: 1rpx solid var(--brand-100);
  color: var(--brand-700);
}

.hero-progress-card {
  margin-top: 20rpx;
  padding: 22rpx 20rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(24, 179, 104, 0.1);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.hero-progress-value {
  font-size: 48rpx;
  font-weight: 820;
  line-height: 1.08;
  letter-spacing: -0.6rpx;
  color: var(--neutral-950);
}

.hero-progress-note {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--neutral-700);
}

.hero-progress-track {
  margin-top: 14rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--neutral-100);
  overflow: hidden;
}

.hero-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand-500) 0%, #29c77a 100%);
  transition: width 200ms ease;
}

.hero-actions-panel {
  margin-top: 18rpx;
  padding: 14rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.05);
}

.hero-btn {
  width: 100%;
  min-width: 0;
}

.hero-primary {
  margin-top: 0 !important;
}

.hero-primary-hover {
  transform: scale(0.992);
  filter: brightness(0.98);
}

/* --- Round Card --- */
.round-card {
  border-radius: 20rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.round-card-current {
  border-color: var(--brand-100);
  border-left: 6rpx solid var(--brand-500);
  box-shadow: 0 8rpx 24rpx rgba(24, 179, 104, 0.1);
}

.round-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 4rpx 4rpx 12rpx;
}

.round-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--neutral-950);
}

.count-pill-active {
  background: var(--brand-50);
  border-color: var(--brand-100);
  color: var(--brand-600);
}

/* --- Match Card --- */
.match-card {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  background: var(--neutral-100);
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid var(--neutral-200);
  transition: border-color 120ms ease, background 120ms ease;
}

.match-card:last-child {
  margin-bottom: 0;
}

.match-card-focus {
  border-color: var(--brand-500);
  background: var(--brand-50);
  box-shadow: inset 0 0 0 1rpx rgba(24, 179, 104, 0.12);
}

.match-left {
  flex: 1;
  min-width: 0;
}

.match-title {
  font-weight: 780;
  color: var(--neutral-950);
  font-size: 28rpx;
  margin-bottom: 6rpx;
}

.match-sub {
  color: var(--neutral-700);
  font-size: 26rpx;
  line-height: 36rpx;
  word-break: break-word;
}

.vs {
  color: var(--neutral-300);
  margin: 0 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.score {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--brand-700);
}

.focus-pill {
  margin-top: 8rpx;
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(24, 179, 104, 0.1);
  color: var(--brand-700);
  font-size: 21rpx;
  font-weight: 700;
}

.match-right {
  display: flex;
  align-items: flex-start;
}

.pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.pill-pending {
  background: rgba(24, 179, 104, 0.1);
  color: var(--brand-700);
}

.pill-finished {
  background: var(--info-100);
  color: var(--info-500);
}

.pill-canceled {
  background: var(--neutral-100);
  color: var(--neutral-500);
}

.team-meta {
  margin-top: 4rpx;
}

.rest {
  padding: 4rpx 8rpx 0;
}

/* --- State Cards --- */
.state-card {
  margin-top: 16rpx;
}

.state-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: var(--neutral-700);
}

.state-link {
  margin-top: 12rpx;
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 12rpx;
  color: var(--brand-600);
  font-size: 24rpx;
  font-weight: 700;
}

/* --- Skeleton 拟真化 --- */
.skeleton-match-block {
  margin-top: 16rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  background: var(--neutral-100);
  border: 1rpx solid var(--neutral-200);
}
