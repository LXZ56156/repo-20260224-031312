/* Schedule 页面样式 — 赛事中控台风 */

.schedule-page {
  padding-top: var(--space-page-y);
}

.schedule-page.with-filter-bar {
  padding-bottom: calc(env(safe-area-inset-bottom) + 172rpx);
}

/* --- Hero 重构：表面优先的赛事状态卡 --- */
.schedule-page .hero {
  padding: var(--space-hero-pad-y) var(--space-hero-pad-x);
  border-radius: 24rpx;
  border: 1rpx solid rgba(24, 179, 104, 0.12);
  background:
    radial-gradient(circle at 88% 12%, rgba(24, 179, 104, 0.14) 0%, rgba(24, 179, 104, 0.03) 30%, transparent 54%),
    linear-gradient(180deg, rgba(241, 252, 245, 0.98) 0%, rgba(255, 255, 255, 0.98) 52%, #ffffff 100%);
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
  color: var(--neutral-950);
}

.hero-head {
  display: flex;
  align-items: flex-start;
  gap: var(--space-section);
}

.hero-main {
  flex: 1;
  min-width: 0;
}

.hero-kicker {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--neutral-500);
  letter-spacing: 0.3rpx;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.3rpx;
  color: var(--neutral-950);
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--neutral-500);
}

.hero-status {
  display: inline-flex;
  align-items: center;
  gap: var(--space-tight);
  min-height: 52rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  white-space: nowrap;
  flex-shrink: 0;
}

.hero-status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: currentColor;
  flex: none;
}

.hero-status-running {
  background: rgba(24, 179, 104, 0.12);
  border: 1rpx solid rgba(24, 179, 104, 0.18);
  color: var(--brand-700);
}

.hero-status-draft {
  background: var(--neutral-100);
  border: 1rpx solid var(--neutral-200);
  color: var(--neutral-700);
}

.hero-status-finished {
  background: var(--brand-50);
  border: 1rpx solid var(--brand-100);
  color: var(--brand-700);
}

.hero-progress-card {
  margin-top: var(--space-section);
  padding: var(--space-card-pad-lg);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(24, 179, 104, 0.1);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.88);
}

.hero-progress-value {
  font-size: 48rpx;
  font-weight: 820;
  line-height: 1.08;
  letter-spacing: -0.6rpx;
  color: var(--neutral-950);
}

.hero-progress-note {
  margin-top: var(--space-tight);
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--neutral-700);
}

.hero-progress-track {
  margin-top: var(--space-inline);
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--neutral-100);
  overflow: hidden;
}

.hero-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--brand-500) 0%, #29c77a 100%);
  transition: width 200ms ease;
}

.hero-actions-panel {
  margin-top: var(--space-section);
  padding: var(--space-panel-pad);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.05);
}

.hero-btn {
  width: 100%;
  min-width: 0;
}

.hero-primary {
  margin-top: 0 !important;
}

.hero-primary-hover {
  transform: scale(0.992);
  filter: brightness(0.98);
}

/* --- Round Card --- */
.round-card {
  border-radius: 20rpx;
  padding: var(--space-card-pad);
  margin-top: var(--space-inline);
  transition: transform 100ms ease, filter 100ms ease, border-color 120ms ease, box-shadow 120ms ease;
}

.round-card-current {
  border-color: var(--brand-100);
  border-left: 6rpx solid var(--brand-500);
  box-shadow: 0 8rpx 24rpx rgba(24, 179, 104, 0.1);
}

.round-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 2rpx 2rpx var(--space-tight);
}

.round-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--neutral-950);
}

.count-pill-active {
  background: var(--brand-50);
  border-color: var(--brand-100);
  color: var(--brand-600);
}

/* --- Match Card --- */
.match-card {
  background: var(--neutral-100);
  border-radius: 14rpx;
  padding: var(--space-panel-pad);
  margin-bottom: var(--space-tight);
  border: 1rpx solid var(--neutral-200);
  transition: transform 100ms ease, filter 100ms ease, border-color 120ms ease, background 120ms ease;
}

.match-card:last-child {
  margin-bottom: 0;
}

.match-card-focus {
  border-color: var(--brand-500);
  background: var(--brand-50);
  box-shadow: inset 0 0 0 1rpx rgba(24, 179, 104, 0.12);
}

.match-card-main {
  display: flex;
  align-items: stretch;
  gap: var(--space-inline);
}

.match-title {
  color: var(--neutral-400);
  font-size: 26rpx;
  font-weight: 780;
}

.match-team {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.match-team-avatars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-tight);
}

.match-team-name-line {
  margin-top: var(--space-section);
  width: 100%;
  text-align: center;
  color: var(--neutral-950);
  font-size: 30rpx;
  font-weight: 760;
  line-height: 1.25;
  white-space: nowrap;
}

.match-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.match-avatar-img {
  width: 72rpx;
  height: 72rpx;
}

.match-avatar-initial {
  font-size: 26rpx;
  font-weight: 800;
  color: #ffffff;
}

.match-center {
  width: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.vs {
  color: var(--neutral-500);
  font-size: 30rpx;
  font-weight: 600;
}

.focus-pill {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(24, 179, 104, 0.1);
  color: var(--brand-700);
  font-size: 21rpx;
  font-weight: 700;
}

.match-side-rail {
  width: 132rpx;
  padding-left: 18rpx;
  border-left: 1rpx solid rgba(15, 23, 42, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  gap: var(--space-section);
}

.match-score-row {
  display: flex;
  align-items: baseline;
  gap: var(--space-tight);
}

.match-score {
  font-size: 42rpx;
  font-weight: 780;
  color: var(--neutral-950);
  letter-spacing: -0.4rpx;
}

.match-score.score-win {
  color: var(--brand-600);
}

.match-score-sep {
  font-size: 28rpx;
  color: var(--neutral-300);
}

.match-card-foot {
  margin-top: var(--space-tight);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-tight);
}

.match-note {
  flex: 1;
  min-width: 0;
  text-align: right;
  color: var(--neutral-500);
  font-size: 22rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.pill {
  background: rgba(255, 255, 255, 0.9);
}

.pill-pending {
  background: rgba(24, 179, 104, 0.1);
  color: var(--brand-700);
}

.pill-finished {
  background: var(--info-100);
  color: var(--info-500);
}

.pill-canceled {
  background: var(--neutral-100);
  color: var(--neutral-500);
}

.rest {
  padding: 4rpx 8rpx 0;
}

/* --- Filter Bar --- */
.schedule-filter-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  min-height: 96rpx;
  padding: 0 20rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 14rpx 30rpx rgba(15, 23, 42, 0.12);
  z-index: 80;
  display: flex;
  align-items: center;
  gap: var(--space-section);
}

.schedule-filter-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--space-section);
}

.filter-trigger {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  color: var(--neutral-900);
  font-size: 28rpx;
  font-weight: 700;
}

.filter-trigger-right {
  min-width: 140rpx;
  justify-content: flex-end;
}

.filter-arrow {
  color: var(--brand-500);
  font-size: 20rpx;
}

.selected-player-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.selected-player-list {
  display: inline-flex;
  align-items: center;
  gap: var(--space-inline);
}

.selected-player-chip {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.selected-player-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.12);
}

.selected-player-img {
  width: 64rpx;
  height: 64rpx;
}

.selected-player-initial {
  font-size: 24rpx;
  font-weight: 800;
  color: #ffffff;
}

.selected-player-remove {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #60a5fa;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(59, 130, 246, 0.28);
}

.filter-clear {
  flex-shrink: 0;
  color: #60a5fa;
  font-size: 28rpx;
  font-weight: 700;
}

.filter-clear.disabled {
  color: var(--neutral-300);
}

.filter-divider {
  width: 1rpx;
  align-self: stretch;
  background: rgba(15, 23, 42, 0.08);
}

/* --- Filter Sheet --- */
.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}

.schedule-filter-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(245, 251, 247, 0.98) 0%, rgba(255, 255, 255, 0.99) 24%, #ffffff 100%);
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
  border-radius: 28rpx 28rpx 0 0;
  padding: var(--space-section) 32rpx calc(env(safe-area-inset-bottom) + 32rpx);
  z-index: 101;
  box-shadow: 0 -8rpx 30rpx rgba(15, 23, 42, 0.12);
}

.sheet-open {
  transform: translateY(0);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: var(--neutral-300);
  margin: 0 auto 20rpx;
}

.filter-sheet-title {
  font-size: 32rpx;
  font-weight: 780;
  color: var(--neutral-950);
  text-align: center;
}

.filter-sheet-option {
  margin-top: var(--space-card-pad-lg);
  padding: var(--space-card-pad-lg) var(--space-section);
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
  font-size: 28rpx;
  color: var(--neutral-900);
  text-align: center;
}

.filter-sheet-option.active {
  color: var(--brand-600);
  font-weight: 780;
}

.filter-sheet-actions {
  margin-top: var(--space-page-bottom);
  display: flex;
  min-width: 0;
  gap: var(--space-section);
}

.filter-sheet-actions .btn {
  flex: 1;
  width: 0;
  min-width: 0;
}

/* --- State Cards --- */
.state-card {
  margin-top: var(--space-section);
}

.state-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: var(--space-tight);
  color: var(--neutral-700);
}

.state-link {
  margin-top: var(--space-inline);
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 12rpx;
  color: var(--brand-600);
  font-size: 24rpx;
  font-weight: 700;
}

/* --- Skeleton 拟真化 --- */
.skeleton-match-block {
  margin-top: var(--space-tight);
  padding: var(--space-panel-pad);
  border-radius: 16rpx;
  background: var(--neutral-100);
  border: 1rpx solid var(--neutral-200);
}
