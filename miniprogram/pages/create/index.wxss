.create-page {
  padding-top: 24rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

.create-hero {
  padding: 24rpx 24rpx 22rpx;
}

.create-hero-sub {
  max-width: 540rpx;
}

.create-panel {
  padding-top: 20rpx;
}

.form-block {
  margin-top: 16rpx;
}

.field-label {
  margin-bottom: 8rpx;
  color: var(--neutral-500);
  font-size: 24rpx;
}

.create-flow {
  padding-top: 18rpx;
}

.create-flow-item {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  background: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--neutral-700);
}

.create-actions {
  margin-top: 0;
}
