.create-page {
  padding-top: var(--space-page-y);
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

.create-hero {
  padding: var(--space-hero-pad-y) var(--space-hero-pad-x);
}

.create-hero-sub {
  max-width: 540rpx;
}

.create-panel {
  padding-top: var(--space-card-pad);
}

.form-block {
  margin-top: var(--space-form);
}

.field-label {
  margin-bottom: 8rpx;
  color: var(--neutral-500);
  font-size: 24rpx;
}

.create-flow {
  padding-top: var(--space-card-pad);
}

.create-flow-item {
  margin-top: var(--space-inline);
  padding: var(--space-section) var(--space-card-pad);
  border-radius: 16rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  background: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--neutral-700);
}

.create-actions {
  margin-top: 0;
}
