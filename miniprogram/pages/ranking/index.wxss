/* Ranking 页面样式 — 积分榜风 */

.ranking-page {
  padding-top: 24rpx;
}

/* --- Hero 积分榜感 --- */
.hero-kicker {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--neutral-500);
  letter-spacing: 0.5rpx;
}

/* --- Ranking Card --- */
.ranking-card {
  margin-top: 12rpx;
}

.ranking-card-top {
  border-color: rgba(24, 179, 104, 0.14);
  background: linear-gradient(180deg, rgba(246, 253, 248, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
}

.ranking-card-1st {
  border-color: rgba(245, 158, 11, 0.18);
  background: linear-gradient(180deg, rgba(255, 250, 239, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  box-shadow: 0 8rpx 20rpx rgba(245, 158, 11, 0.08);
}

.ranking-card-2nd {
  border-color: rgba(148, 163, 184, 0.18);
  background: linear-gradient(180deg, rgba(248, 250, 252, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  box-shadow: 0 8rpx 20rpx rgba(100, 116, 139, 0.05);
}

.ranking-card-3rd {
  border-color: rgba(217, 119, 6, 0.16);
  background: linear-gradient(180deg, rgba(255, 246, 238, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  box-shadow: 0 8rpx 20rpx rgba(217, 119, 6, 0.05);
}

.ranking-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.ranking-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.player-title {
  font-size: 30rpx;
  font-weight: 760;
  color: var(--neutral-950);
}

.ranking-right {
  flex-shrink: 0;
  text-align: right;
}

.metric-title {
  font-size: 28rpx;
  font-weight: 780;
  color: var(--neutral-950);
}

/* --- Ranking subtitle (team members) --- */
.ranking-subtitle {
  font-size: 22rpx;
  color: var(--neutral-500);
  line-height: 1.35;
  margin-top: 2rpx;
}

/* --- Trend Pill 紧凑化 --- */
.trend-pill {
  margin-top: 4rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 88rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  color: var(--neutral-500);
  background: rgba(255, 255, 255, 0.9);
}

.trend-pill.up {
  color: var(--brand-700);
  border-color: rgba(24, 179, 104, 0.16);
  background: rgba(24, 179, 104, 0.08);
}

.trend-pill.down {
  color: #9F1239;
  border-color: #FBCFE8;
  background: #FFF1F6;
}

/* --- Empty Title (兼容) --- */
.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: var(--neutral-700);
}

/* --- Ranking Skeleton --- */
.ranking-skeleton-list {
  margin-top: 8rpx;
}
