/* Ranking 页面样式 — 积分榜风 */

.ranking-page {
  padding-top: var(--space-page-y);
}

/* --- Hero 积分榜感 --- */
.hero-kicker {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--neutral-500);
  letter-spacing: 0.5rpx;
}

.ranking-hero-actions {
  margin-top: var(--space-section);
}

.ranking-action-stack {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-tight);
}

.ranking-action-row {
  display: flex;
  gap: var(--space-tight);
}

.ranking-page .ranking-hero-actions .ranking-action-stack .btn {
  margin: 0 !important;
  min-width: 0;
  max-width: 100%;
  white-space: nowrap;
  line-height: 72rpx;
  height: 72rpx;
  font-size: 26rpx;
}

.ranking-page .ranking-hero-actions .ranking-action-full {
  width: 100% !important;
  flex: none !important;
}

.ranking-page .ranking-hero-actions .ranking-action-half {
  width: 0 !important;
  flex: 1 1 0 !important;
}

.ranking-share-banner {
  margin-top: var(--space-tight);
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(245, 158, 11, 0.14);
  background: rgba(255, 250, 239, 0.78);
  box-shadow: none;
}

.ranking-share-banner-title {
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
  color: #92400E;
}

.ranking-share-banner-sub {
  margin-top: 2rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--neutral-500);
}

/* --- Ranking Card --- */
.ranking-card {
  margin-top: var(--space-tight);
  padding: var(--space-panel-pad) var(--space-card-pad);
  transition: transform 100ms ease, filter 100ms ease, border-color 120ms ease, box-shadow 120ms ease;
}

.ranking-card-top {
  border-color: rgba(24, 179, 104, 0.14);
  background: linear-gradient(180deg, rgba(246, 253, 248, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
}

.ranking-card-1st {
  border-color: rgba(245, 158, 11, 0.18);
  background: linear-gradient(180deg, rgba(255, 250, 239, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  box-shadow: 0 8rpx 20rpx rgba(245, 158, 11, 0.08);
}

.ranking-card-2nd {
  border-color: rgba(148, 163, 184, 0.18);
  background: linear-gradient(180deg, rgba(248, 250, 252, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  box-shadow: 0 8rpx 20rpx rgba(100, 116, 139, 0.05);
}

.ranking-card-3rd {
  border-color: rgba(217, 119, 6, 0.16);
  background: linear-gradient(180deg, rgba(255, 246, 238, 0.98) 0%, rgba(255, 255, 255, 0.98) 100%);
  box-shadow: 0 8rpx 20rpx rgba(217, 119, 6, 0.05);
}

.ranking-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-tight);
}

.ranking-main-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-section);
  min-width: 0;
}

.ranking-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: var(--space-tight);
}

.ranking-avatar-group {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: var(--space-tight);
}

.ranking-avatar-group.pair {
  gap: var(--space-tight);
}

.ranking-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.ranking-avatar-img {
  width: 60rpx;
  height: 60rpx;
}

.ranking-avatar-initial {
  font-size: 24rpx;
  font-weight: 800;
  color: #ffffff;
}

.player-title {
  font-size: 28rpx;
  font-weight: 760;
  color: var(--neutral-950);
  line-height: 1.3;
}

.ranking-right {
  flex-shrink: 0;
  width: 148rpx;
  text-align: right;
}

.ranking-record-line,
.ranking-score-line {
  line-height: 1.35;
  white-space: nowrap;
}

.ranking-card-foot {
  display: flex;
  align-items: center;
  gap: var(--space-tight);
  min-width: 0;
  padding-left: 58rpx;
}

.rank-row-share {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  min-width: 0;
  max-width: 100%;
  min-height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: rgba(24, 179, 104, 0.10);
  color: var(--brand-700);
  font-size: 22rpx;
  font-weight: 760;
  line-height: 40rpx;
}

.rank-row-share::after {
  border: 0;
}

.metric-title {
  font-size: 26rpx;
  font-weight: 780;
  color: var(--neutral-950);
  line-height: 1.35;
}

/* --- Ranking subtitle (team members) --- */
.ranking-subtitle {
  font-size: 21rpx;
  color: var(--neutral-500);
  line-height: 1.35;
  margin-top: 2rpx;
}

/* --- Trend Pill 紧凑化 --- */
.trend-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex: 0 1 auto;
  max-width: 54%;
  min-width: 0;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.35;
  border: 1rpx solid rgba(15, 23, 42, 0.08);
  color: var(--neutral-500);
  background: rgba(255, 255, 255, 0.9);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.trend-pill.up {
  color: var(--brand-700);
  border-color: rgba(24, 179, 104, 0.16);
  background: rgba(24, 179, 104, 0.08);
}

.trend-pill.down {
  color: #9F1239;
  border-color: #FBCFE8;
  background: #FFF1F6;
}

/* --- Empty Title (兼容) --- */
.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  color: var(--neutral-700);
}

/* --- Ranking Skeleton --- */
.ranking-skeleton-list {
  margin-top: var(--space-tight);
}

.ranking-skeleton-list .skeleton-card {
  margin-top: var(--space-tight);
  padding: var(--space-panel-pad) var(--space-card-pad);
}

.ranking-page.density-comfortable .ranking-card,
.ranking-page.density-comfortable .ranking-skeleton-list .skeleton-card {
  margin-top: var(--space-inline);
  padding: var(--space-card-pad-lg);
}

.ranking-page.density-comfortable .ranking-row,
.ranking-page.density-comfortable .ranking-main-row,
.ranking-page.density-comfortable .ranking-left,
.ranking-page.density-comfortable .ranking-avatar-group {
  gap: var(--space-inline);
}

.ranking-page.density-comfortable .ranking-avatar,
.ranking-page.density-comfortable .ranking-avatar-img {
  width: 68rpx;
  height: 68rpx;
}
